    async function bulkDeleteUsers() {
        const result = await Swal.fire({
            title: 'Are you sure?',
            html: `
                <div class="text-left">
                    <p class="mb-2">This will deactivate <strong>${selectedUsers.size}</strong> user account(s).</p>
                    <p class="text-sm text-gray-500">Deactivated users will not be able to log in until reactivated.</p>
                </div>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, deactivate them!',
            cancelButtonText: 'Cancel'
        });
        
        if (result.isConfirmed) {
            try {
                const deletePromises = Array.from(selectedUsers).map(id =>
                    axios.delete(`/api/users/${id}`).then(res => res.data)
                );
                
                const results = await Promise.allSettled(deletePromises);
                const successCount = results.filter(r => r.status === 'fulfilled' && r.value.success).length;
                
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: `${successCount} users deactivated`,
                    confirmButtonColor: '#3b82f6'
                }).then(() => {
                    location.reload();
                });
                
            } catch (error) {
                console.error('Bulk delete error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to deactivate users',
                    confirmButtonColor: '#3b82f6'
                });
            }
        }
    }
    
    async function exportUsersToFormat(format) {
        try {
            // Get current filter values
            const params = new URLSearchParams();
            
            if (roleFilter.val()) params.set('role', roleFilter.val());
            if (statusFilter.val()) params.set('status', statusFilter.val());
            if (createdAfter.val()) params.set('createdAfter', createdAfter.val());
            if (createdBefore.val()) params.set('createdBefore', createdBefore.val());
            params.set('format', format);
            
            // Show loading
            Swal.fire({
                title: 'Exporting...',
                text: 'Please wait while we prepare your export',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            // Fetch and download
            const response = await axios.get(`/api/users/export?${params.toString()}`, {
                responseType: 'blob'
            });
            
            Swal.close();
            
            const blob = new Blob([response.data]);
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            
            // Get filename from content-disposition header
            const contentDisposition = response.headers['content-disposition'];
            let filename = `users_export.${format}`;
            if (contentDisposition) {
                const filenameMatch = contentDisposition.match(/filename="(.+)"/);
                if (filenameMatch && filenameMatch[1]) {
                    filename = filenameMatch[1];
                }
            }
            
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            
            Swal.fire({
                icon: 'success',
                title: 'Export Complete',
                text: `Your ${format.toUpperCase()} file has been downloaded`,
                confirmButtonColor: '#3b82f6'
            });
            
        } catch (error) {
            console.error('Export error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Export Failed',
                text: error.response?.data?.message || 'Failed to export users',
                confirmButtonColor: '#3b82f6'
            });
        }
    }
    
    async function loadUserStatistics() {
        try {
            const response = await axios.get('/api/users/statistics');
            if (response.data.success) {
                const stats = response.data.statistics;
                
                // Update online users count
                $('#onlineUsers').text(stats.activity?.online || 0);
                
                // Update progress bars
                updateProgressBars(stats);
            }
        } catch (error) {
            console.error('Error loading user statistics:', error);
        }
    }
    
    function updateProgressBars(stats = null) {
        if (!stats && window.pageStats) {
            stats = window.pageStats;
        }
        
        if (!stats || !stats.byRole || !stats.total) return;
        
        const total = stats.total || 1; // Avoid division by zero
        
        // Update progress bar widths
        $('#adminBar').css('width', ((stats.byRole.admin || 0) / total * 100) + '%');
        $('#techBar').css('width', ((stats.byRole.technician || 0) / total * 100) + '%');
        $('#viewerBar').css('width', ((stats.byRole.viewer || 0) / total * 100) + '%');
    }
    
    function initRoleDistributionChart() {
        const ctx = document.getElementById('roleDistributionChart');
        if (!ctx) return;
        
        const stats = window.pageStats || {};
        const roleData = stats.byRole || { admin: 0, technician: 0, viewer: 0 };
        
        new Chart(ctx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['Administrators', 'Technicians', 'Viewers'],
                datasets: [{
                    data: [roleData.admin || 0, roleData.technician || 0, roleData.viewer || 0],
                    backgroundColor: [
                        '#dc2626', // Red for admin
                        '#2563eb', // Blue for technician
                        '#059669'  // Green for viewer
                    ],
                    borderWidth: 1,
                    hoverOffset: 15
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            padding: 15,
                            font: {
                                size: 11
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const label = context.label || '';
                                const value = context.raw || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                return `${label}: ${value} (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });
    }
    
