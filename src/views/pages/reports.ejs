<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>


// Helper functions for formatting
function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function timeAgo(date) {
    const seconds = Math.floor((new Date() - new Date(date)) / 1000);
    
    let interval = Math.floor(seconds / 31536000);
    if (interval >= 1) return interval + ' year' + (interval > 1 ? 's' : '') + ' ago';
    
    interval = Math.floor(seconds / 2592000);
    if (interval >= 1) return interval + ' month' + (interval > 1 ? 's' : '') + ' ago';
    
    interval = Math.floor(seconds / 86400);
    if (interval >= 1) return interval + ' day' + (interval > 1 ? 's' : '') + ' ago';
    
    interval = Math.floor(seconds / 3600);
    if (interval >= 1) return interval + ' hour' + (interval > 1 ? 's' : '') + ' ago';
    
    interval = Math.floor(seconds / 60);
    if (interval >= 1) return interval + ' minute' + (interval > 1 ? 's' : '') + ' ago';
    
    return 'just now';
}

// Also add this function to handle report file size display
function formatReportFileSize(fileSize) {
    return formatFileSize(fileSize);
}


// Global variables
let currentReportId = null;
let currentTemplate = null;
let selectedTemplate = null;

// Initialize date picker
flatpickr("#reportDateRange", {
    mode: "range",
    dateFormat: "Y-m-d",
    maxDate: "today",
    defaultDate: [new Date().fp_incr(-7), new Date().fp_incr(-1)]
});

// Initialize custom schedule date picker
flatpickr("#customScheduleTime", {
    enableTime: true,
    dateFormat: "Y-m-d H:i",
    minDate: "today"
});

// DOM Content Loaded
document.addEventListener('DOMContentLoaded', function() {
    // Initialize
    loadReportStats();
    loadPopularReports();
    loadCategoryCounts();
    setupEventListeners();
});

// Load report statistics
async function loadReportStats() {
    try {
        const response = await fetch('/api/reports/stats');
        const data = await response.json();
        
        if (data.success) {
            document.getElementById('totalDownloads').textContent = 
                data.totalDownloads || 0;
            document.getElementById('storageAvailable').textContent = 
                data.storageAvailable || '10 GB';
        }
    } catch (error) {
        console.error('Error loading report stats:', error);
    }
}

// Load popular reports
async function loadPopularReports() {
    try {
        const response = await fetch('/api/reports/popular?limit=5');
        const data = await response.json();
        
        const container = document.getElementById('popularReports');
        container.innerHTML = '';
        
        if (data.success && data.data.length > 0) {
            data.data.forEach(report => {
                const div = document.createElement('div');
                div.className = 'flex items-center justify-between p-2 bg-gray-50 rounded hover:bg-gray-100 cursor-pointer';
                div.innerHTML = `
                    <div>
                        <div class="font-medium text-sm text-gray-800">${report.title}</div>
                        <div class="text-xs text-gray-500">${report.type} • ${report.downloadCount} downloads</div>
                    </div>
                    <button class="download-btn px-2 py-1 bg-blue-100 text-blue-600 text-xs rounded hover:bg-blue-200"
                            data-id="${report._id}">
                        <i class="fas fa-download"></i>
                    </button>
                `;
                container.appendChild(div);
            });
        } else {
            container.innerHTML = `
                <div class="text-center py-4 text-gray-400">
                    <i class="fas fa-chart-line text-2xl mb-2"></i>
                    <p class="text-sm">No popular reports yet</p>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error loading popular reports:', error);
    }
}

// Load category counts
async function loadCategoryCounts() {
    try {
        const response = await fetch('/api/reports/categories');
        const data = await response.json();
        
        if (data.success) {
            data.categories.forEach(category => {
                const element = document.getElementById(`${category.id}Count`);
                if (element) {
                    element.textContent = category.count || 0;
                }
            });
        }
    } catch (error) {
        console.error('Error loading category counts:', error);
    }
}

// Setup event listeners
function setupEventListeners() {
    // Quick Generate Button
    document.getElementById('quickGenerateBtn').addEventListener('click', () => {
        showModal('quickGenerateModal');
    });
    
    // Templates Button
    document.getElementById('templatesBtn').addEventListener('click', async () => {
        await loadTemplates();
        showModal('templatesModal');
    });
    
    // Schedule Button
    document.getElementById('scheduleBtn').addEventListener('click', () => {
        showModal('scheduleModal');
    });
    
    // Refresh Button
    document.getElementById('refreshReports').addEventListener('click', () => {
        location.reload();
    });
    
    // Generate Report Button
    document.getElementById('generateReportBtn').addEventListener('click', generateReport);
    
    // Search functionality
    document.getElementById('searchReports').addEventListener('input', debounce(searchReports, 300));
    
    // Filter functionality
    document.getElementById('reportFilter').addEventListener('change', filterReports);
    
    // Category cards
    document.querySelectorAll('.category-card').forEach(card => {
        card.addEventListener('click', () => {
            const category = card.dataset.category;
            filterByCategory(category);
        });
    });
    
    // Quick template buttons
    document.querySelectorAll('.quick-template-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            selectedTemplate = btn.dataset.template;
            btn.classList.add('selected');
            document.querySelectorAll('.quick-template-btn').forEach(b => {
                if (b !== btn) b.classList.remove('selected');
            });
        });
    });
    
    // Schedule frequency change
    document.getElementById('scheduleFrequency').addEventListener('change', function() {
        document.getElementById('customScheduleFields').classList.toggle('hidden', this.value !== 'custom');
    });
    
    // Modal close buttons
    document.getElementById('cancelQuickGenerate').addEventListener('click', () => hideModal('quickGenerateModal'));
    document.getElementById('closeTemplates').addEventListener('click', () => hideModal('templatesModal'));
    document.getElementById('cancelShare').addEventListener('click', () => hideModal('shareReportModal'));
    document.getElementById('cancelSchedule').addEventListener('click', () => hideModal('scheduleModal'));
    
    // Confirm actions
    document.getElementById('confirmQuickGenerate').addEventListener('click', confirmQuickGenerate);
    document.getElementById('confirmShare').addEventListener('click', confirmShare);
    document.getElementById('confirmSchedule').addEventListener('click', confirmSchedule);
    document.getElementById('copyShareId').addEventListener('click', copyShareId);
}

// Modal functions
function showModal(modalId) {
    document.getElementById(modalId).classList.remove('hidden');
}

function hideModal(modalId) {
    document.getElementById(modalId).classList.add('hidden');
}

// Load templates
async function loadTemplates() {
    try {
        const response = await fetch('/api/reports/templates');
        const data = await response.json();
        
        const container = document.getElementById('templatesList');
        container.innerHTML = '';
        
        if (data.success && data.templates.length > 0) {
            data.templates.forEach(template => {
                const div = document.createElement('div');
                div.className = 'template-card p-4 cursor-pointer';
                div.dataset.id = template.id;
                div.innerHTML = `
                    <div class="flex items-start">
                        <div class="p-3 rounded-lg bg-${getColorForTemplate(template.type)}-100 mr-3">
                            <i class="fas ${getIconForTemplate(template.type)} text-${getColorForTemplate(template.type)}-600"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-medium text-gray-800">${template.name}</h4>
                            <p class="text-sm text-gray-600 mt-1">${template.description}</p>
                            <div class="mt-2 flex items-center text-xs text-gray-500">
                                <span class="mr-3">${template.type}</span>
                                <span>${template.defaultFormat}</span>
                            </div>
                        </div>
                    </div>
                `;
                
                div.addEventListener('click', () => {
                    selectTemplate(template);
                });
                
                container.appendChild(div);
            });
        }
    } catch (error) {
        console.error('Error loading templates:', error);
    }
}

// Template helpers
function getColorForTemplate(type) {
    const colors = {
        daily: 'blue',
        weekly: 'green',
        monthly: 'yellow',
        custom: 'purple'
    };
    return colors[type] || 'gray';
}

function getIconForTemplate(type) {
    const icons = {
        daily: 'fa-sun',
        weekly: 'fa-calendar-week',
        monthly: 'fa-calendar-alt',
        custom: 'fa-edit'
    };
    return icons[type] || 'fa-file-alt';
}

function selectTemplate(template) {
    selectedTemplate = template;
    document.querySelectorAll('.template-card').forEach(card => {
        card.classList.remove('selected');
    });
    event.currentTarget.classList.add('selected');
    
    // Auto-fill form
    document.getElementById('reportType').value = template.type;
    // Set date range based on template
    // Hide modal and show confirmation
    hideModal('templatesModal');
    
    Swal.fire({
        title: `Use ${template.name}?`,
        text: template.description,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Generate Now',
        cancelButtonText: 'Cancel'
    }).then((result) => {
        if (result.isConfirmed) {
            generateFromTemplate(template);
        }
    });
}

// Generate report
async function generateReport() {
    const reportType = document.getElementById('reportType').value;
    const dateRange = document.getElementById('reportDateRange').value;
    const format = document.querySelector('input[name="format"]:checked').value;
    const includeCharts = document.getElementById('includeCharts').checked;
    const includeRawData = document.getElementById('includeRawData').checked;
    const sendEmail = document.getElementById('sendEmail').checked;
    
    if (!dateRange) {
        Swal.fire('Error', 'Please select a date range', 'error');
        return;
    }
    
    const [startDate, endDate] = dateRange.split(' to ');
    
    showLoading('Generating Report', 'Please wait while we generate your report...');
    
    try {
        const response = await fetch('/api/reports/generate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                type: reportType,
                format: format,
                startDate: startDate,
                endDate: endDate,
                includeRawData: includeRawData,
                emailRecipients: sendEmail ? [/* user email */] : []
            })
        });
        
        const data = await response.json();
        
        hideLoading();
        
        if (data.success) {
            Swal.fire({
                title: 'Success!',
                text: 'Report generated successfully',
                icon: 'success',
                confirmButtonText: 'Download',
                showCancelButton: true,
                cancelButtonText: 'View Details'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Download the report
                    window.location.href = data.data.downloadUrl;
                } else {
                    // Show report details
                    showReportDetails(data.data);
                }
            });
        } else {
            Swal.fire('Error', data.message || 'Failed to generate report', 'error');
        }
    } catch (error) {
        hideLoading();
        Swal.fire('Error', 'Failed to generate report: ' + error.message, 'error');
    }
}

// Confirm quick generate
function confirmQuickGenerate() {
    if (!selectedTemplate) {
        Swal.fire('Error', 'Please select a template', 'error');
        return;
    }
    
    const format = document.getElementById('quickFormat').value;
    
    hideModal('quickGenerateModal');
    
    showLoading('Generating Report', 'Creating your report...');
    
    // Simulate report generation
    simulateReportGeneration(selectedTemplate, format);
}

// Simulate report generation with progress
function simulateReportGeneration(template, format) {
    let progress = 0;
    const progressInterval = setInterval(() => {
        progress += 10;
        updateLoadingProgress(progress, `Processing... ${progress}%`);
        
        if (progress >= 100) {
            clearInterval(progressInterval);
            hideLoading();
            
            Swal.fire({
                title: 'Report Ready!',
                text: `${template} report has been generated.`,
                icon: 'success',
                confirmButtonText: 'Download',
                showCancelButton: true,
                cancelButtonText: 'Close'
            }).then((result) => {
                if (result.isConfirmed) {
                    // In real app, this would download the actual file
                    // For now, show success
                    Swal.fire('Success', 'Report download started', 'success');
                }
            });
        }
    }, 300);
}

// Generate from template
function generateFromTemplate(template) {
    // Set form values based on template
    document.getElementById('reportType').value = template.type;
    // Set appropriate date range based on template type
    const now = new Date();
    let startDate, endDate;
    
    switch(template.type) {
        case 'daily':
            startDate = new Date(now.setDate(now.getDate() - 1));
            endDate = new Date();
            break;
        case 'weekly':
            startDate = new Date(now.setDate(now.getDate() - 7));
            endDate = new Date();
            break;
        case 'monthly':
            startDate = new Date(now.setMonth(now.getMonth() - 1));
            endDate = new Date();
            break;
        default:
            startDate = new Date(now.setDate(now.getDate() - 7));
            endDate = new Date();
    }
    
    // Format dates for flatpickr
    const dateRange = `${formatDate(startDate)} to ${formatDate(endDate)}`;
    document.getElementById('reportDateRange').value = dateRange;
    
    // Trigger generation
    setTimeout(() => {
        document.getElementById('generateReportBtn').click();
    }, 100);
}

// Format date for flatpickr
function formatDate(date) {
    return date.toISOString().split('T')[0];
}

// Confirm share
async function confirmShare() {
    const reportId = document.getElementById('shareReportId').value;
    const users = Array.from(document.getElementById('shareUsers').selectedOptions).map(opt => opt.value);
    const makePublic = document.getElementById('makePublic').checked;
    
    try {
        const response = await fetch(`/api/reports/${reportId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                isPublic: makePublic,
                sharedWith: users
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            Swal.fire('Success', 'Report shared successfully', 'success');
            hideModal('shareReportModal');
            location.reload(); // Refresh to show updated sharing
        } else {
            Swal.fire('Error', data.message || 'Failed to share report', 'error');
        }
    } catch (error) {
        Swal.fire('Error', 'Failed to share report: ' + error.message, 'error');
    }
}

// Copy share ID
function copyShareId() {
    const input = document.getElementById('shareReportId');
    input.select();
    document.execCommand('copy');
    Swal.fire('Copied!', 'Report ID copied to clipboard', 'success');
}

// Confirm schedule
async function confirmSchedule() {
    const template = document.getElementById('scheduleTemplate').value;
    const frequency = document.getElementById('scheduleFrequency').value;
    const customTime = document.getElementById('customScheduleTime').value;
    const recipients = document.getElementById('scheduleRecipients').value;
    const enableSchedule = document.getElementById('enableSchedule').checked;
    
    const scheduleData = {
        templateId: template,
        scheduleType: frequency,
        recipients: recipients ? recipients.split(',').map(email => email.trim()) : [],
        format: 'pdf',
        includeCharts: true
    };
    
    if (frequency === 'custom' && customTime) {
        scheduleData.scheduleTime = customTime;
    }
    
    try {
        const response = await fetch('/api/reports/schedule', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(scheduleData)
        });
        
        const data = await response.json();
        
        if (data.success) {
            Swal.fire({
                title: 'Scheduled!',
                text: `Report scheduled for ${frequency} delivery`,
                icon: 'success',
                confirmButtonText: 'View Schedules',
                showCancelButton: true,
                cancelButtonText: 'Close'
            }).then((result) => {
                if (result.isConfirmed) {
                    // View scheduled reports
                    viewScheduledReports();
                }
            });
            
            hideModal('scheduleModal');
        } else {
            Swal.fire('Error', data.message || 'Failed to schedule report', 'error');
        }
    } catch (error) {
        Swal.fire('Error', 'Failed to schedule report: ' + error.message, 'error');
    }
}

// View scheduled reports
async function viewScheduledReports() {
    try {
        const response = await fetch('/api/reports/scheduled');
        const data = await response.json();
        
        if (data.success) {
            let scheduleList = '<div class="space-y-3">';
            data.scheduledReports.forEach(schedule => {
                scheduleList += `
                    <div class="p-3 border border-gray-200 rounded-lg">
                        <div class="flex justify-between items-center">
                            <div>
                                <h4 class="font-medium text-gray-800">${schedule.name}</h4>
                                <div class="text-sm text-gray-600">
                                    ${schedule.scheduleType} • Next: ${new Date(schedule.nextRun).toLocaleString()}
                                </div>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full ${schedule.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                ${schedule.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </div>
                    </div>
                `;
            });
            scheduleList += '</div>';
            
            Swal.fire({
                title: 'Scheduled Reports',
                html: scheduleList,
                width: 600,
                showConfirmButton: false,
                showCloseButton: true
            });
        }
    } catch (error) {
        Swal.fire('Error', 'Failed to load scheduled reports', 'error');
    }
}

// Report action handlers (delegated events)
document.addEventListener('click', async function(e) {
    // Download button
    if (e.target.closest('.download-btn')) {
        const btn = e.target.closest('.download-btn');
        const reportId = btn.dataset.id;
        await downloadReport(reportId);
    }
    
    // Preview button
    if (e.target.closest('.preview-btn')) {
        const btn = e.target.closest('.preview-btn');
        const reportId = btn.dataset.id;
        await previewReport(reportId);
    }
    
    // Share button
    if (e.target.closest('.share-btn')) {
        const btn = e.target.closest('.share-btn');
        const reportId = btn.dataset.id;
        await shareReport(reportId);
    }
    
    // Clone button
    if (e.target.closest('.clone-btn')) {
        const btn = e.target.closest('.clone-btn');
        const reportId = btn.dataset.id;
        await cloneReport(reportId);
    }
    
    // Delete button
    if (e.target.closest('.delete-btn')) {
        const btn = e.target.closest('.delete-btn');
        const reportId = btn.dataset.id;
        await deleteReport(reportId);
    }
});

// Download report
async function downloadReport(reportId) {
    try {
        window.location.href = `/api/reports/download/${reportId}`;
    } catch (error) {
        Swal.fire('Error', 'Failed to download report: ' + error.message, 'error');
    }
}

// Preview report
async function previewReport(reportId) {
    try {
        window.open(`/api/reports/preview/${reportId}`, '_blank');
    } catch (error) {
        Swal.fire('Error', 'Failed to preview report: ' + error.message, 'error');
    }
}

// Share report
async function shareReport(reportId) {
    currentReportId = reportId;
    document.getElementById('shareReportId').value = reportId;
    
    // Load users for sharing
    try {
        const response = await fetch('/api/users?role=all');
        const data = await response.json();
        
        const select = document.getElementById('shareUsers');
        select.innerHTML = '';
        
        if (data.success && data.data.length > 0) {
            data.data.forEach(user => {
                const option = document.createElement('option');
                option.value = user._id;
                option.textContent = `${user.name} (${user.email})`;
                select.appendChild(option);
            });
        }
    } catch (error) {
        console.error('Error loading users:', error);
    }
    
    showModal('shareReportModal');
}

// Clone report
async function cloneReport(reportId) {
    Swal.fire({
        title: 'Clone Report?',
        text: 'Create a copy of this report',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Clone',
        cancelButtonText: 'Cancel'
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                showLoading('Cloning Report', 'Creating a copy of the report...');
                
                const response = await fetch(`/api/reports/${reportId}/clone`, {
                    method: 'POST'
                });
                
                const data = await response.json();
                
                hideLoading();
                
                if (data.success) {
                    Swal.fire({
                        title: 'Cloned!',
                        text: 'Report cloned successfully',
                        icon: 'success',
                        confirmButtonText: 'Download Clone',
                        showCancelButton: true,
                        cancelButtonText: 'View'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = data.data.downloadUrl;
                        } else {
                            location.reload();
                        }
                    });
                } else {
                    Swal.fire('Error', data.message || 'Failed to clone report', 'error');
                }
            } catch (error) {
                hideLoading();
                Swal.fire('Error', 'Failed to clone report: ' + error.message, 'error');
            }
        }
    });
}

// Delete report
async function deleteReport(reportId) {
    Swal.fire({
        title: 'Delete Report?',
        text: 'This action cannot be undone',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Delete',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#dc2626'
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const response = await fetch(`/api/reports/${reportId}`, {
                    method: 'DELETE'
                });
                
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire('Deleted!', 'Report deleted successfully', 'success');
                    // Remove report from DOM
                    const reportCard = document.querySelector(`.delete-btn[data-id="${reportId}"]`).closest('.report-card');
                    reportCard.remove();
                    
                    // Update counts
                    updateCountsAfterDeletion();
                } else {
                    Swal.fire('Error', data.message || 'Failed to delete report', 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Failed to delete report: ' + error.message, 'error');
            }
        }
    });
}

// Update counts after deletion
function updateCountsAfterDeletion() {
    const totalReports = document.getElementById('totalReports');
    const currentCount = parseInt(totalReports.textContent);
    if (currentCount > 0) {
        totalReports.textContent = currentCount - 1;
    }
    
    // TODO: Update other counts as needed
}

// Search reports
function searchReports() {
    const searchTerm = document.getElementById('searchReports').value.toLowerCase();
    const reportCards = document.querySelectorAll('.report-card');
    
    reportCards.forEach(card => {
        const title = card.querySelector('h3').textContent.toLowerCase();
