<!-- Enhanced Sidebar with more options -->
<aside class="bg-gradient-to-b from-gray-900 to-black text-white w-64 min-h-screen fixed left-0 top-0 pt-16 z-30 glass-sidebar" id="sidebar">
    <div class="p-4 h-full overflow-y-auto">
        <!-- User Info Section -->
        <div class="mb-8 pb-6 border-b border-gray-700">
            
            <div class="flex space-x-2">
                <div class="flex-1 bg-gray-800 rounded-lg p-2 text-center">
                    <p class="text-xs text-gray-400">Last Login</p>
                    <p class="text-sm text-white"><%= user.lastLogin ? new Date(user.lastLogin).toLocaleDateString() : 'Today' %></p>
                </div>
                <div class="flex-1 bg-gray-800 rounded-lg p-2 text-center">
                    <p class="text-xs text-gray-400">Status</p>
                    <p class="text-sm text-green-400">Active</p>
                </div>
            </div>
        </div>
        
        <nav class="mt-2">
            <!-- Dashboard Section -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-home w-4 mr-2"></i>
                    Dashboard
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/dashboard" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath === '/dashboard' ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-tachometer-alt w-5 mr-3"></i>
                            Overview
                            <% if (currentPath === '/dashboard') { %>
                                <span class="ml-auto w-2 h-2 bg-yellow-500 rounded-full animate-pulse"></span>
                            <% } %>
                        </a>
                    </li>
                    <li>
                        <a href="/dashboard/live-data" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/live-data') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-bolt w-5 mr-3"></i>
                            Live Data
                            <% if (recentAlerts && recentAlerts.filter(a => !a.resolved).length > 0) { %>
                                <span class="ml-auto bg-red-500 text-white text-xs px-2 py-1 rounded-full">
                                    <%= recentAlerts.filter(a => !a.resolved).length %>
                                </span>
                            <% } %>
                        </a>
                    </li>
                    <li>
                        <a href="/api/status" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-server w-5 mr-3"></i>
                            System Status
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Monitoring Section -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-chart-line w-4 mr-2"></i>
                    Monitoring
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/alerts" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/alerts') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-bell w-5 mr-3"></i>
                            Alerts & Notifications
                            <% if (alertStats && alertStats.total > 0) { %>
                                <span class="ml-auto bg-yellow-500 text-black text-xs px-2 py-1 rounded-full">
                                    <%= alertStats.total %>
                                </span>
                            <% } %>
                        </a>
                    </li>
                    <li>
                        <a href="/reports" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/reports') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-chart-bar w-5 mr-3"></i>
                            Reports & Analytics
                        </a>
                    </li>
                    <li>
                        <a href="/api/alerts/stats" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-chart-pie w-5 mr-3"></i>
                            Statistics
                        </a>
                    </li>
                    <li>
                        <a href="/api/alerts/trends" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-chart-line w-5 mr-3"></i>
                            Trends Analysis
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Data Management -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-database w-4 mr-2"></i>
                    Data Management
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/api/sensor-data" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-microchip w-5 mr-3"></i>
                            Sensor Data
                        </a>
                    </li>
                    <li>
                        <a href="/api/export/sensor-data" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-file-export w-5 mr-3"></i>
                            Export Data
                        </a>
                    </li>
                    <li>
                        <a href="/api/sensor-statistics" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-calculator w-5 mr-3"></i>
                            Data Analysis
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- System Administration -->
            <% if (user.role === 'admin' || user.role === 'technician') { %>
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-cogs w-4 mr-2"></i>
                    Administration
                </h3>
                <ul class="space-y-1">
                    <% if (user.role === 'admin') { %>
                    <li>
                        <a href="/users" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/users') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-users-cog w-5 mr-3"></i>
                            User Management
                        </a>
                    </li>
                    <% } %>
                    <li>
                        <a href="/api/alerts/test-email" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-envelope w-5 mr-3"></i>
                            Test Notifications
                        </a>
                    </li>
                    <li>
                        <a href="/profile" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/profile') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-user-cog w-5 mr-3"></i>
                            System Settings
                        </a>
                    </li>
                </ul>
            </div>
            <% } %>
            
            <!-- User Section -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-user w-4 mr-2"></i>
                    Account
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/profile" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/profile') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-user-circle w-5 mr-3"></i>
                            My Profile
                        </a>
                    </li>
                    <li>
                        <a href="/api/auth/me" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-id-card w-5 mr-3"></i>
                            Account Details
                        </a>
                    </li>
                    <li>
                        <a href="/logout" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-red-600 hover:text-white hover:shadow-md transition-all duration-200">
                            <i class="fas fa-sign-out-alt w-5 mr-3"></i>
                            Logout
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Quick Actions -->
            <div class="mt-8 pt-6 border-t border-gray-700">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3">Quick Actions</h3>
                <div class="grid grid-cols-2 gap-2">
                    <a href="/api/alerts/active/count" class="bg-gray-800 hover:bg-yellow-500 hover:text-black p-3 rounded-lg text-center transition-all duration-200">
                        <i class="fas fa-eye text-sm mb-1"></i>
                        <p class="text-xs mt-1">View Alerts</p>
                    </a>
                    <a href="/reports/api/reports/generate" class="bg-gray-800 hover:bg-yellow-500 hover:text-black p-3 rounded-lg text-center transition-all duration-200">
                        <i class="fas fa-file-alt text-sm mb-1"></i>
                        <p class="text-xs mt-1">New Report</p>
                    </a>
                </div>
            </div>
        </nav>
        
        <!-- System Status Footer -->
        <div class="mt-8 pt-6 border-t border-gray-700">
            <div class="flex items-center justify-between mb-2">
                <span class="text-sm text-gray-400">System Status</span>
                <span class="flex items-center">
                    <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
                    <span class="text-xs text-green-400">Online</span>
                </span>
            </div>
            <div class="text-xs text-gray-500">
                <p>Last Updated: <span id="sidebarTimestamp"><%= new Date().toLocaleTimeString() %></span></p>
                <p>Version: 2.0.0</p>
            </div>
        </div>
    </div>
</aside>

<!-- Mobile menu overlay -->
<div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-70 backdrop-blur-sm z-20 hidden"></div>

<!-- Add to your CSS -->
<style>
    .glass-sidebar {
        background: linear-gradient(135deg, rgba(31, 41, 55, 0.95), rgba(17, 24, 39, 0.95));
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 5px 0 25px rgba(0, 0, 0, 0.3);
    }
    
    .glass-sidebar nav li a {
        position: relative;
        overflow: hidden;
    }
    
    .glass-sidebar nav li a::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        transition: left 0.5s;
    }
    
    .glass-sidebar nav li a:hover::after {
        left: 100%;
    }
    
    /* Yellow theme updates */
    .bg-yellow-500 {
        background-color: #eab308;
    }
    
    .hover\:bg-yellow-500:hover {
        background-color: #eab308;
    }
    
    .text-yellow-500 {
        color: #eab308;
    }
    
    .border-yellow-500 {
        border-color: #eab308;
    }
    
    /* Update header to match */
    header {
        background: linear-gradient(135deg, rgba(31, 41, 55, 0.95), rgba(17, 24, 39, 0.95));
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    /* Update footer */
    footer {
        background: linear-gradient(135deg, rgba(31, 41, 55, 0.95), rgba(17, 24, 39, 0.95));
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>

<!-- JavaScript for sidebar behavior -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        
        // Always open sidebar on desktop
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('hidden');
        }
        
        // Mobile menu toggle
        document.getElementById('mobileMenuButton')?.addEventListener('click', function() {
            sidebar.classList.toggle('hidden');
            sidebarOverlay.classList.toggle('hidden');
        });
        
        // Close sidebar on overlay click
        sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.add('hidden');
            sidebarOverlay.classList.add('hidden');
        });
        
        // Auto-hide sidebar on mobile when clicking link
        sidebar.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth < 768) {
                    sidebar.classList.add('hidden');
                    sidebarOverlay.classList.add('hidden');
                }
            });
        });
        
        // Update timestamp every minute
        function updateTimestamp() {
            const timestampEl = document.getElementById('sidebarTimestamp');
            if (timestampEl) {
                timestampEl.textContent = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            }
        }
        setInterval(updateTimestamp, 60000);
    });
</script>