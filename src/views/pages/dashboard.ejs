<!-- JavaScript Libraries -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
// Dashboard state
let dashboardState = {
    currentPeriod: '7d',
    charts: {},
    isLoading: false,
    lastUpdate: null
};

// Initialize dashboard
document.addEventListener('DOMContentLoaded', function() {
    initializeDashboard();
    setupEventListeners();
    loadDashboardData();
    startRealTimeUpdates();
});

// Initialize dashboard components
function initializeDashboard() {
    // Initialize charts
    initializeCharts();
    
    // Set initial time
    dashboardState.lastUpdate = new Date();
    updateLastUpdateTime();
}

// Initialize ApexCharts
function initializeCharts() {
    // Power Production Chart
    dashboardState.charts.power = new ApexCharts(document.querySelector("#powerChart"), {
        series: [],
        chart: {
            type: 'area',
            height: '100%',
            toolbar: { show: true },
            animations: { enabled: true, easing: 'easeinout', speed: 800 }
        },
        colors: ['#f59e0b'],
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 3 },
        fill: {
            type: 'gradient',
            gradient: {
                shadeIntensity: 1,
                opacityFrom: 0.7,
                opacityTo: 0.1,
                stops: [0, 90, 100]
            }
        },
        xaxis: { type: 'datetime' },
        yaxis: { title: { text: 'Power (W)' } },
        grid: { borderColor: '#e5e7eb' },
        noData: {
            text: 'Loading power data...',
            align: 'center',
            verticalAlign: 'middle'
        }
    });
    
    dashboardState.charts.power.render();
    
    // Voltage & Current Chart
    dashboardState.charts.voltageCurrent = new ApexCharts(document.querySelector("#voltageCurrentChart"), {
        series: [],
        chart: {
            type: 'line',
            height: '100%',
            toolbar: { show: false }
        },
        colors: ['#3b82f6', '#10b981'],
        stroke: { width: [3, 3], curve: 'smooth' },
        dataLabels: { enabled: false },
        markers: { size: 4 },
        xaxis: { type: 'datetime' },
        yaxis: [
            { title: { text: 'Voltage (V)' } },
            { opposite: true, title: { text: 'Current (A)' } }
        ],
        grid: { borderColor: '#e5e7eb' },
        noData: {
            text: 'Loading electrical data...',
            align: 'center',
            verticalAlign: 'middle'
        }
    });
    
    dashboardState.charts.voltageCurrent.render();
    
    // Temperature Chart
    dashboardState.charts.temperature = new ApexCharts(document.querySelector("#temperatureChart"), {
        series: [],
        chart: {
            type: 'line',
            height: '100%',
            toolbar: { show: false }
        },
        colors: ['#ef4444'],
        stroke: { width: 3, curve: 'smooth' },
        fill: {
            type: 'gradient',
            gradient: {
                shadeIntensity: 1,
                opacityFrom: 0.7,
                opacityTo: 0.1,
                stops: [0, 90, 100]
            }
        },
        markers: { size: 4 },
        xaxis: { type: 'datetime' },
        yaxis: { 
            title: { text: 'Temperature (°C)' },
            min: 0,
            max: 100
        },
        grid: { borderColor: '#e5e7eb' },
        annotations: {
            yaxis: [
                { y: 60, borderColor: '#f59e0b', label: { text: 'Warning', style: { color: '#f59e0b', background: '#fffbeb' } } },
                { y: 80, borderColor: '#ef4444', label: { text: 'Critical', style: { color: '#ef4444', background: '#fef2f2' } } }
            ]
        },
        noData: {
            text: 'Loading temperature data...',
            align: 'center',
            verticalAlign: 'middle'
        }
    });
    
    dashboardState.charts.temperature.render();
}

// Setup event listeners
function setupEventListeners() {
    // Refresh button
    document.getElementById('refreshDashboard').addEventListener('click', function() {
        this.classList.add('refresh-animation');
        setTimeout(() => this.classList.remove('refresh-animation'), 1000);
        loadDashboardData();
    });
    
    // Time period filters
    document.querySelectorAll('.time-filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const parent = this.closest('.time-filter');
            parent.querySelectorAll('.time-filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            
            if (this.dataset.period) {
                dashboardState.currentPeriod = this.dataset.period;
                loadDashboardData();
            }
            
            if (this.dataset.chartPeriod) {
                updateChartPeriod(this.dataset.chartPeriod);
            }
        });
    });
    
    // Export chart data
    document.getElementById('exportChartData').addEventListener('click', exportChartData);
}

// Load dashboard data from API endpoints
async function loadDashboardData() {
    if (dashboardState.isLoading) return;
    
    dashboardState.isLoading = true;
    showLoadingState(true);
    
    try {
        // Load real-time data
        const realtimeData = await fetchData('/dashboard/api/realtime');
        if (realtimeData.success) {
            updateRealTimeMetrics(realtimeData.data);
        }
        
        // Load historical data for charts
        const historicalData = await fetchData(`/dashboard/api/historical?period=${dashboardState.currentPeriod}&interval=hour`);
        if (historicalData.success) {
            updateChartsWithData(historicalData.data);
        }
        
        // Load system stats
        const statsData = await fetchData('/dashboard/api/stats?days=7');
        
        // Load alerts
        const alertsData = await fetchData('/alerts/api/alerts?status=active&limit=5');
        if (alertsData.success) {
            updateAlertsDisplay(alertsData.data);
        }
        
        // Update last update time
        dashboardState.lastUpdate = new Date();
        updateLastUpdateTime();
        
    } catch (error) {
        console.error('Error loading dashboard data:', error);
        showErrorState();
    } finally {
        dashboardState.isLoading = false;
        showLoadingState(false);
    }
}

// Fetch data from API endpoint
async function fetchData(url) {
    try {
        const response = await axios.get(url);
        return response.data;
    } catch (error) {
        console.error(`Error fetching ${url}:`, error);
        throw error;
    }
}

// Update real-time metrics display
function updateRealTimeMetrics(data) {
    if (!data) return;
    
    // Update power metric
    const powerMetric = document.getElementById('powerMetric');
    if (powerMetric) {
        if (data.power && data.power.value) {
            const power = data.power.value;
            powerMetric.innerHTML = `
                <div class="metric-value">
                    ${power.toFixed(1)}
                    <span class="sensor-unit">W</span>
                </div>
                <div class="metric-label">
                    ${power > 300 ? 
                        '<span class="stat-badge badge-success"><i class="fas fa-arrow-up mr-1"></i> High Production</span>' : 
                     power > 150 ? 
                        '<span class="stat-badge badge-yellow"><i class="fas fa-minus mr-1"></i> Medium</span>' : 
                        '<span class="stat-badge badge-warning"><i class="fas fa-arrow-down mr-1"></i> Low</span>'
                    }
                </div>
            `;
        }
    }
    
    // Update other metrics in the UI
    updateMetricDisplays(data);
}

// Update charts with data
function updateChartsWithData(data) {
    if (!data || !data.series) {
        showEmptyChartState();
        return;
    }
    
    // Update power chart
    if (dashboardState.charts.power && data.series.power) {
        dashboardState.charts.power.updateSeries([{
            name: 'Power',
            data: data.series.power
        }]);
    }
    
    // Update voltage & current chart
    if (dashboardState.charts.voltageCurrent && data.series.voltage && data.series.current) {
        dashboardState.charts.voltageCurrent.updateSeries([
            { name: 'Voltage', data: data.series.voltage },
            { name: 'Current', data: data.series.current }
        ]);
    }
    
    // Update temperature chart
    if (dashboardState.charts.temperature && data.series.temperature) {
        dashboardState.charts.temperature.updateSeries([{
            name: 'Temperature',
            data: data.series.temperature
        }]);
    }
}

// Update alerts display
function updateAlertsDisplay(alerts) {
    const container = document.getElementById('recentAlertsList');
    if (!container) return;
    
    const activeAlerts = alerts.filter(alert => !alert.resolved);
    
    if (activeAlerts.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-bell-slash"></i>
                </div>
                <div class="empty-state-title">No Recent Alerts</div>
                <div class="empty-state-description">System is operating normally</div>
            </div>
        `;
        return;
    }
    
    let html = '<div class="space-y-3">';
    activeAlerts.slice(0, 5).forEach(alert => {
        const time = new Date(alert.createdAt).toLocaleDateString();
        html += `
            <div class="activity-item">
                <div class="activity-icon">
                    <span class="alert-severity severity-${alert.severity}"></span>
                </div>
                <div class="activity-content">
                    <div class="activity-title">${alert.title}</div>
                    <div class="text-xs text-gray-600 mb-1">${alert.message}</div>
                    <div class="activity-time">
                        ${time} • ${alert.deviceId || 'System'}
                    </div>
                </div>
            </div>
        `;
    });
    html += '</div>';
    
    container.innerHTML = html;
}

// Update metric displays
function updateMetricDisplays(data) {
    // Update battery level if available
    if (data.batteryLevel) {
        const batteryElement = document.querySelector('.metric-item:nth-child(1) .metric-value');
        if (batteryElement) {
            batteryElement.innerHTML = `${data.batteryLevel}%`;
        }
    }
    
    // Update temperature status
    if (data.temperature) {
        const temp = data.temperature.value;
        const statusElement = document.querySelector('.sensor-status');
        if (statusElement) {
            if (temp > 70) {
                statusElement.className = 'sensor-status status-critical';
                statusElement.textContent = 'Critical';
            } else if (temp > 60) {
                statusElement.className = 'sensor-status status-warning';
                statusElement.textContent = 'Warning';
            } else {
                statusElement.className = 'sensor-status status-normal';
                statusElement.textContent = 'Normal';
            }
        }
    }
}

