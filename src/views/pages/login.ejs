<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login – Solar Monitoring System</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="min-h-screen bg-black text-white">

<!-- Background -->
<div class="fixed inset-0 bg-gradient-to-br from-gray-900 via-black to-gray-800"></div>
<div class="fixed inset-0 bg-black bg-opacity-50"></div>

<!-- Container -->
<div class="relative min-h-screen flex items-center justify-center px-4">

    <!-- Login Card -->
    <div class="w-full max-w-md bg-gray-900 bg-opacity-90 backdrop-blur-xl border border-gray-700 rounded-2xl shadow-2xl p-8">

        <!-- Logo -->
        <div class="flex justify-center mb-6">
            <div class="w-20 h-20 rounded-xl bg-yellow-500 flex items-center justify-center shadow-lg">
                <i class="fas fa-solar-panel text-black text-3xl"></i>
            </div>
        </div>

        <!-- Title -->
        <h1 class="text-2xl font-bold text-center mb-2 text-white">
            Solar Monitoring System
        </h1>
        <p class="text-sm text-gray-400 text-center mb-8">
            Secure access to energy insights
        </p>

        <!-- Alert Messages -->
        <div id="alertContainer"></div>

        <!-- Login Form -->
        <form id="loginForm" class="space-y-5">

            <!-- Email -->
            <div>
                <label for="email" class="text-sm text-gray-300 block mb-1">Email</label>
                <input 
                    type="email" 
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    class="w-full px-4 py-3 rounded-lg bg-gray-800 border border-gray-600 focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50 outline-none transition-all text-white placeholder-gray-500"
                    placeholder="you@example.com"
                >
            </div>

            <!-- Password -->
            <div>
                <label for="password" class="text-sm text-gray-300 block mb-1">Password</label>
                <div class="relative">
                    <input 
                        type="password" 
                        id="password"
                        name="password"
                        required
                        autocomplete="current-password"
                        class="w-full px-4 py-3 pr-12 rounded-lg bg-gray-800 border border-gray-600 focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50 outline-none transition-all text-white placeholder-gray-500"
                        placeholder="••••••••"
                    >
                    <button 
                        type="button"
                        id="togglePassword"
                        class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-yellow-500 p-2 rounded hover:bg-gray-700 transition-colors"
                        tabindex="-1"
                    >
                        <i class="fas fa-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input 
                        type="checkbox" 
                        id="remember"
                        name="remember"
                        class="h-4 w-4 rounded border-gray-600 bg-gray-800 text-yellow-500 focus:ring-yellow-500 focus:ring-offset-0 cursor-pointer"
                    >
                    <label for="remember" class="ml-2 text-sm text-gray-300 cursor-pointer select-none">
                        Remember me
                    </label>
                </div>
                <a href="/forgot-password" class="text-sm text-yellow-500 hover:text-yellow-400 transition-colors">
                    Forgot password?
                </a>
            </div>

            <!-- Submit Button -->
            <button 
                type="submit"
                id="submitBtn"
                class="w-full py-3 bg-yellow-500 hover:bg-yellow-600 active:bg-yellow-700 text-black font-semibold rounded-lg transition-colors duration-200 focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2 focus:ring-offset-gray-900 disabled:opacity-50 disabled:cursor-not-allowed"
            >
                <span id="btnText">Sign In</span>
            </button>

        </form>

        <!-- Footer -->
        <p class="text-xs text-gray-500 text-center mt-6">
            © <span id="year"></span> Solar Monitoring System
        </p>

    </div>
</div>

<!-- jQuery -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- Axios -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.0/axios.min.js"></script>

<script>
$(document).ready(function() {
    // Set current year
    $('#year').text(new Date().getFullYear());

    // Focus on email input
    $('#email').focus();

    // Password toggle functionality
    $('#togglePassword').on('click', function() {
        const passwordInput = $('#password');
        const eyeIcon = $('#eyeIcon');
        
        if (passwordInput.attr('type') === 'password') {
            passwordInput.attr('type', 'text');
            eyeIcon.removeClass('fa-eye').addClass('fa-eye-slash');
        } else {
            passwordInput.attr('type', 'password');
            eyeIcon.removeClass('fa-eye-slash').addClass('fa-eye');
        }
    });

    // Show alert message
    function showAlert(type, message) {
        const isError = type === 'error';
        const bgColor = isError ? 'bg-red-500' : 'bg-green-500';
        const borderColor = isError ? 'border-red-400' : 'border-green-400';
        const textColor = isError ? 'text-red-100' : 'text-green-100';
        const icon = isError ? 'fa-exclamation-circle' : 'fa-check-circle';
        
        const alert = `
            <div class="alert-message mb-4 ${bgColor} bg-opacity-20 border ${borderColor} ${textColor} text-sm p-3 rounded-lg animate-fade-in">
                <i class="fas ${icon} mr-2"></i>${message}
            </div>
        `;
        
        $('#alertContainer').html(alert);
        
        // Auto-hide success messages after 5 seconds
        if (!isError) {
            setTimeout(() => {
                $('.alert-message').fadeOut(300, function() {
                    $(this).remove();
                });
            }, 5000);
        }
    }

    // Clear alerts
    function clearAlert() {
        $('#alertContainer').empty();
    }

    // Set loading state
    function setLoading(isLoading) {
        const submitBtn = $('#submitBtn');
        const btnText = $('#btnText');
        
        if (isLoading) {
            submitBtn.prop('disabled', true);
            btnText.html('<i class="fas fa-spinner fa-spin mr-2"></i>Signing in...');
        } else {
            submitBtn.prop('disabled', false);
            btnText.text('Sign In');
        }
    }

    // Form validation
    function validateForm(email, password) {
        clearAlert();
        
        if (!email || !email.trim()) {
            showAlert('error', 'Please enter your email address');
            return false;
        }
        
        // Basic email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
            showAlert('error', 'Please enter a valid email address');
            return false;
        }
        
        if (!password || !password.trim()) {
            showAlert('error', 'Please enter your password');
            return false;
        }
        
        if (password.length < 6) {
            showAlert('error', 'Password must be at least 6 characters');
            return false;
        }
        
        return true;
    }

    // Handle form submission
    $('#loginForm').on('submit', function(e) {
        e.preventDefault();
        
        // Get form data
        const email = $('#email').val().trim();
        const password = $('#password').val();
        const remember = $('#remember').is(':checked');
        
        // Validate
        if (!validateForm(email, password)) {
            return;
        }
        
        // Clear previous alerts
        clearAlert();
        
        // Set loading state
        setLoading(true);
        
        // Make API request
        axios.post('/login', {
            email: email,
            password: password,
            remember: remember
        })
        .then(function(response) {
            // Success
            showAlert('success', 'Login successful! Redirecting...');
            
            // Redirect to dashboard after short delay
            setTimeout(() => {
                window.location.href = response.data.redirect || '/dashboard';
            }, 1000);
        })
        .catch(function(error) {
            // Error handling
            setLoading(false);
            
            if (error.response) {
                // Server responded with error status
                const errorMessage = error.response.data.message || 
                                    error.response.data.error || 
                                    'Invalid email or password';
                showAlert('error', errorMessage);
            } else if (error.request) {
                // Request made but no response
                showAlert('error', 'Unable to connect to server. Please try again.');
            } else {
                // Something else happened
                showAlert('error', 'An unexpected error occurred. Please try again.');
            }
            
            console.error('Login error:', error);
        });
    });

    // Allow Enter key to submit from password field
    $('#password').on('keypress', function(e) {
        if (e.which === 13) {
            $('#loginForm').submit();
        }
    });

    console.log('Login form initialized with jQuery and Axios');
});
</script>

<style>
@keyframes fade-in {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in {
    animation: fade-in 0.3s ease-out;
}
</style>

</body>
</html>