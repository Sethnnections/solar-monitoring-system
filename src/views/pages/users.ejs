<%- include('../partials/head', { title: 'User Management' }); %>
<%- include('../partials/header'); %>
<%- include('../partials/sidebar', { currentPath: '/users' }); %>

<main class="md:ml-64 pt-16 min-h-screen bg-gradient-to-b from-gray-50 to-gray-100">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto">
            <div class="text-center py-12">
                <div class="inline-block p-4 bg-indigo-100 rounded-full mb-6">
                    <i class="fas fa-users-cog text-indigo-600 text-4xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-800 mb-4">User Management</h1>
                <p class="text-lg text-gray-600 mb-8">Administrative user management interface coming soon. Available to admin users only.</p>
                
                <div class="bg-white rounded-lg shadow-lg p-8 border border-gray-200 mt-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="text-center p-4">
                            <div class="inline-block p-3 bg-blue-100 rounded-full mb-3">
                                <i class="fas fa-user-plus text-blue-600"></i>
                            </div>
                            <h3 class="font-semibold text-gray-800">Add Users</h3>
                            <p class="text-gray-600 text-sm mt-1">Create new user accounts</p>
                        </div>
                        
                        <div class="text-center p-4">
                            <div class="inline-block p-3 bg-green-100 rounded-full mb-3">
                                <i class="fas fa-edit text-green-600"></i>
                            </div>
                            <h3 class="font-semibold text-gray-800">Edit Users</h3>
                            <p class="text-gray-600 text-sm mt-1">Modify user permissions</p>
                        </div>
                        
                        <div class="text-center p-4">
                            <div class="inline-block p-3 bg-red-100 rounded-full mb-3">
                                <i class="fas fa-user-slash text-red-600"></i>
                            </div>
                            <h3 class="font-semibold text-gray-800">Manage Access</h3>
                            <p class="text-gray-600 text-sm mt-1">Control user access levels</p>
                        </div>
                    </div>
                </div>
                
                <div class="mt-8 text-sm text-gray-500">
                    <p><i class="fas fa-info-circle mr-2"></i>This section is restricted to administrators only.</p>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer'); %>
<%- include('../partials/scripts'); %>