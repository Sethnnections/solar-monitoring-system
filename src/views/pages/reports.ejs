
<%- include('../partials/head', { 
    title: 'Report Center - Solar Monitoring System',
    extraStyles: `
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-dark@5/dark.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
        <style>
            .report-card {
                transition: all 0.3s ease;
                border: 2px solid transparent;
            }
            .report-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
                border-color: #3b82f6;
            }
            .format-badge {
                padding: 2px 8px;
                border-radius: 12px;
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
            }
            .format-pdf { background-color: #dc2626; color: white; }
            .format-excel { background-color: #059669; color: white; }
            .format-csv { background-color: #2563eb; color: white; }
            .format-json { background-color: #7c3aed; color: white; }
            .category-card {
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }
            .category-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            }
            .category-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            }
            .template-card {
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                transition: all 0.2s ease;
                cursor: pointer;
            }
            .template-card:hover {
                border-color: #3b82f6;
                box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.1), 0 2px 4px -1px rgba(59, 130, 246, 0.06);
            }
            .template-card.selected {
                border-color: #3b82f6;
                background-color: #eff6ff;
            }
            .animate-pulse {
                animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
            }
            @keyframes pulse {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.5; }
            }
            .progress-bar {
                transition: width 0.6s ease;
            }
            .sticky-header {
                position: sticky;
                top: 4rem;
                z-index: 10;
                background-color: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
            }
        </style>
    ` 
}); %>
<%- include('../partials/header'); %>
<%- include('../partials/sidebar'); %>

<!-- Main Content -->
<main class="md:ml-64 pt-16 min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-6">
        <!-- Page Header -->
        <div class="mb-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">Report Center</h1>
                    <p class="text-gray-600">Generate, manage, and analyze system reports</p>
                </div>
                <div class="mt-4 md:mt-0 flex space-x-3">
                    <!-- Quick Generate Button -->
                    <button id="quickGenerateBtn" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-200">
                        <i class="fas fa-plus-circle mr-2"></i> Quick Generate
                    </button>
                    
                    <!-- Templates Button -->
                    <button id="templatesBtn" class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition duration-200">
                        <i class="fas fa-layer-group mr-2"></i> Templates
                    </button>
                    
                    <!-- Schedule Button -->
                    <button id="scheduleBtn" class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition duration-200">
                        <i class="fas fa-calendar-alt mr-2"></i> Schedule
                    </button>
                    
                    <!-- Refresh Button -->
                    <button id="refreshReports" class="inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition duration-200">
                        <i class="fas fa-sync-alt mr-2"></i> Refresh
                    </button>
                </div>
            </div>
            
            <!-- Report Summary Cards -->
            <div class="mt-6 grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-blue-100 rounded-lg mr-4">
                            <i class="fas fa-file-alt text-blue-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Total Reports</p>
                            <p class="text-2xl font-bold text-gray-800" id="totalReports">
                                <%= stats ? stats.totalReports : 0 %>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-green-100 rounded-lg mr-4">
                            <i class="fas fa-download text-green-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Total Downloads</p>
                            <p class="text-2xl font-bold text-gray-800" id="totalDownloads">
                                Loading...
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-yellow-100 rounded-lg mr-4">
                            <i class="fas fa-chart-pie text-yellow-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Storage Used</p>
                            <p class="text-2xl font-bold text-gray-800" id="storageUsed">
                                <%= stats && stats.totalSize ? helpers.formatFileSize(stats.totalSize) : '0 MB' %>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-purple-100 rounded-lg mr-4">
                            <i class="fas fa-bolt text-purple-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Recent Reports</p>
                            <p class="text-2xl font-bold text-gray-800" id="recentReports">
                                <%= stats && stats.recentReports ? stats.recentReports : 0 %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Report Categories -->
        <div class="mb-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-4">Report Categories</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <div class="category-card bg-white rounded-lg shadow p-4 text-center cursor-pointer hover:shadow-md transition-shadow duration-200" data-category="all">
                    <div class="w-12 h-12 mx-auto mb-3 bg-blue-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-chart-bar text-blue-600 text-xl"></i>
                    </div>
                    <h3 class="font-medium text-gray-800">All Reports</h3>
                    <p class="text-sm text-gray-600 mt-1" id="allCount">
                        <%= stats ? stats.totalReports : 0 %>
                    </p>
                </div>
                
                <div class="category-card bg-white rounded-lg shadow p-4 text-center cursor-pointer hover:shadow-md transition-shadow duration-200" data-category="performance">
                    <div class="w-12 h-12 mx-auto mb-3 bg-green-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-chart-line text-green-600 text-xl"></i>
                    </div>
                    <h3 class="font-medium text-gray-800">Performance</h3>
                    <p class="text-sm text-gray-600 mt-1" id="performanceCount">
                        <%= stats && stats.byType && stats.byType.daily ? stats.byType.daily : 0 %>
                    </p>
                </div>
                
                <div class="category-card bg-white rounded-lg shadow p-4 text-center cursor-pointer hover:shadow-md transition-shadow duration-200" data-category="analysis">
                    <div class="w-12 h-12 mx-auto mb-3 bg-yellow-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-chart-bar text-yellow-600 text-xl"></i>
                    </div>
                    <h3 class="font-medium text-gray-800">Analysis</h3>
                    <p class="text-sm text-gray-600 mt-1" id="analysisCount">Loading...</p>
                </div>
                
                <div class="category-card bg-white rounded-lg shadow p-4 text-center cursor-pointer hover:shadow-md transition-shadow duration-200" data-category="alerts">
                    <div class="w-12 h-12 mx-auto mb-3 bg-red-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                    </div>
                    <h3 class="font-medium text-gray-800">Alerts</h3>
                    <p class="text-sm text-gray-600 mt-1" id="alertsCount">Loading...</p>
                </div>
                
                <div class="category-card bg-white rounded-lg shadow p-4 text-center cursor-pointer hover:shadow-md transition-shadow duration-200" data-category="maintenance">
                    <div class="w-12 h-12 mx-auto mb-3 bg-indigo-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-tools text-indigo-600 text-xl"></i>
                    </div>
                    <h3 class="font-medium text-gray-800">Maintenance</h3>
                    <p class="text-sm text-gray-600 mt-1" id="maintenanceCount">Loading...</p>
                </div>
                
                <div class="category-card bg-white rounded-lg shadow p-4 text-center cursor-pointer hover:shadow-md transition-shadow duration-200" data-category="custom">
                    <div class="w-12 h-12 mx-auto mb-3 bg-purple-100 rounded-full flex items-center justify-content-center">
                        <i class="fas fa-edit text-purple-600 text-xl"></i>
                    </div>
                    <h3 class="font-medium text-gray-800">Custom</h3>
                    <p class="text-sm text-gray-600 mt-1" id="customCount">
                        <%= stats && stats.byType && stats.byType.custom ? stats.byType.custom : 0 %>
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Reports List -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow sticky-header">
                    <div class="px-6 py-4 border-b">
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                            <h2 class="text-lg font-semibold text-gray-800">Recent Reports</h2>
                            <div class="mt-2 md:mt-0 flex space-x-2">
                                <!-- Search -->
                                <div class="relative">
                                    <input type="text" id="searchReports" 
                                           placeholder="Search reports..." 
                                           class="px-3 py-2 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm w-full md:w-64">
                                    <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                </div>
                                
                                <!-- Filter Dropdown -->
                                <div class="relative">
                                    <select id="reportFilter" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm">
                                        <option value="all">All Reports</option>
                                        <option value="public">Public Only</option>
                                        <option value="mine">My Reports</option>
                                        <option value="shared">Shared with Me</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="space-y-4" id="reportsList">
                            <% if (reports && reports.length > 0) { %>
                                <% reports.forEach(function(report) { %>
                                    <div class="report-card bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-all duration-200">
                                        <div class="flex flex-col md:flex-row md:items-center justify-between">
                                            <!-- Report Info -->
                                            <div class="flex-1">
                                                <div class="flex items-start justify-between">
                                                    <div>
                                                        <h3 class="font-semibold text-gray-800 text-lg">
                                                            <%= report.title %>
                                                        </h3>
                                                        <div class="flex items-center mt-1 space-x-3">
                                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                                <i class="fas 
                                                                    <%= report.type === 'daily' ? 'fa-calendar-day' : 
                                                                       report.type === 'weekly' ? 'fa-calendar-week' : 
                                                                       report.type === 'monthly' ? 'fa-calendar-alt' : 
                                                                       'fa-edit' %> mr-1">
                                                                </i>
                                                                <%= report.type %>
                                                            </span>
                                                            <span class="format-badge format-<%= report.format %>">
                                                                <%= report.format %>
                                                            </span>
                                                            <% if (report.isPublic) { %>
                                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                    <i class="fas fa-globe mr-1"></i>Public
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <p class="text-sm text-gray-600 mt-2">
                                                            Period: <%= report.formattedPeriod %>
                                                            <span class="mx-2">•</span>
                                                            <%= report.durationDays %> days
                                                        </p>
                                                        <div class="flex items-center mt-2 text-sm text-gray-500">
                                                            <i class="fas fa-user mr-1"></i>
                                                            <span><%= report.generatedBy.name %></span>
                                                            <span class="mx-2">•</span>
                                                            <i class="fas fa-clock mr-1"></i>
                                                            <span><%= helpers.timeAgo(report.createdAt) %></span>
                                                            <span class="mx-2">•</span>
                                                            <i class="fas fa-download mr-1"></i>
                                                            <span><%= report.downloadCount || 0 %> downloads</span>
                                                        </div>
                                                    </div>
                                                    
                                                    <!-- File Size -->
                                                    <div class="text-right ml-4">
                                                        <div class="text-sm font-medium text-gray-800">
                                                        <%= stats && stats.totalSize ? helpers.formatFileSize(stats.totalSize) : '0 Bytes   ' %>
                                                        </div>
                                                        <div class="text-xs text-gray-500">
                                                            <%= report.format.toUpperCase() %>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- Summary Stats -->
                                                <% if (report.summary && report.summary.totalEnergy) { %>
                                                <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-2">
                                                    <div class="bg-gray-50 p-2 rounded text-center">
                                                        <div class="text-xs text-gray-500">Energy</div>
                                                        <div class="font-semibold text-gray-800">
                                                            <%= report.summary.totalEnergy.toFixed(2) %> kWh
                                                        </div>
                                                    </div>
                                                    <div class="bg-gray-50 p-2 rounded text-center">
                                                        <div class="text-xs text-gray-500">Avg Voltage</div>
                                                        <div class="font-semibold text-gray-800">
                                                            <%= report.summary.avgVoltage.toFixed(1) %> V
                                                        </div>
                                                    </div>
                                                    <div class="bg-gray-50 p-2 rounded text-center">
                                                        <div class="text-xs text-gray-500">Peak Power</div>
                                                        <div class="font-semibold text-gray-800">
                                                            <%= report.summary.peakPower.toFixed(1) %> W
                                                        </div>
                                                    </div>
                                                    <div class="bg-gray-50 p-2 rounded text-center">
                                                        <div class="text-xs text-gray-500">Data Points</div>
                                                        <div class="font-semibold text-gray-800">
                                                            <%= report.summary.dataPoints %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <!-- Action Buttons -->
                                        <div class="mt-4 flex flex-wrap gap-2">
                                            <button class="download-btn inline-flex items-center px-3 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition duration-200" 
                                                    data-id="<%= report._id %>">
                                                <i class="fas fa-download mr-2"></i>Download
                                            </button>
                                            <% if (report.format === 'pdf') { %>
                                            <button class="preview-btn inline-flex items-center px-3 py-2 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300 transition duration-200" 
                                                    data-id="<%= report._id %>">
                                                <i class="fas fa-eye mr-2"></i>Preview
                                            </button>
                                            <% } %>
                                            <button class="share-btn inline-flex items-center px-3 py-2 bg-green-600 text-white text-sm rounded-lg hover:bg-green-700 transition duration-200" 
                                                    data-id="<%= report._id %>">
                                                <i class="fas fa-share-alt mr-2"></i>Share
                                            </button>
                                            <button class="clone-btn inline-flex items-center px-3 py-2 bg-purple-600 text-white text-sm rounded-lg hover:bg-purple-700 transition duration-200" 
                                                    data-id="<%= report._id %>">
                                                <i class="fas fa-copy mr-2"></i>Clone
                                            </button>
                                            <% if (user.role === 'admin' || report.generatedBy._id.toString() === user.id) { %>
                                            <button class="delete-btn inline-flex items-center px-3 py-2 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700 transition duration-200" 
                                                    data-id="<%= report._id %>">
                                                <i class="fas fa-trash mr-2"></i>Delete
                                            </button>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="text-center py-12 text-gray-500">
                                    <i class="fas fa-file-alt text-4xl mb-3 text-gray-300"></i>
                                    <p class="text-lg">No reports found</p>
                                    <p class="text-sm mt-1">Generate your first report using the templates or quick generate</p>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Pagination -->
                        <% if (pagination) { %>
                            <div class="mt-6 flex items-center justify-between">
                                <div class="text-sm text-gray-700">
                                    Showing <span class="font-medium"><%= pagination.startItem %></span> to 
                                    <span class="font-medium"><%= pagination.endItem %></span> of 
                                    <span class="font-medium"><%= pagination.total %></span> reports
        </div>
        <div class="flex space-x-2">
            <% if (pagination.prevPage) { %>
                <a href="?<%= new URLSearchParams({...filters, page: pagination.prevPage }).toString() %>" 
                   class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                    Previous
                </a>
            <% } %>
            <% if (pagination.pages && pagination.pages.length > 0) { %>
                <% pagination.pages.forEach(function(page) { %>
                    <% if (page.number === pagination.currentPage) { %>
                        <span class="px-3 py-2 bg-blue-600 border border-blue-600 rounded-lg text-sm font-medium text-white">
                            <%= page.number %>
                        </span>
                    <% } else { %>
                        <a href="?<%= new URLSearchParams({...filters, page: page.number }).toString() %>" 
                           class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                            <%= page.number %>
                        </a>
                    <% } %>
                <% }); %>
            <% } %>
                                    
                                    <% if (pagination.nextPage) { %>
                                        <a href="?<%= new URLSearchParams({...filters, page: pagination.nextPage }).toString() %>" 
                                           class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                                            Next
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <!-- Generate Report Card -->
                <div class="bg-white rounded-lg shadow mb-6">
                    <div class="px-6 py-4 border-b">
                        <h2 class="text-lg font-semibold text-gray-800">Generate Report</h2>
                    </div>
                    <div class="p-4">
                        <div class="space-y-4">
                            <!-- Report Type -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Report Type</label>
                                <select id="reportType" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    <% Object.entries(reportTypes).forEach(function([key, value]) { %>
                                        <option value="<%= key %>"><%= value %></option>
                                    <% }); %>
                                </select>
                            </div>
                            
                            <!-- Date Range -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
                                <input type="text" id="reportDateRange" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Select date range">
                            </div>
                            
                            <!-- Format -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Format</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <label class="inline-flex items-center">
                                        <input type="radio" name="format" value="pdf" class="h-4 w-4 text-blue-600 focus:ring-blue-500" checked>
                                        <span class="ml-2 text-sm text-gray-700">PDF</span>
                                    </label>
                                    <label class="inline-flex items-center">
                                        <input type="radio" name="format" value="excel" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                        <span class="ml-2 text-sm text-gray-700">Excel</span>
                                    </label>
                                    <label class="inline-flex items-center">
                                        <input type="radio" name="format" value="csv" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                        <span class="ml-2 text-sm text-gray-700">CSV</span>
                                    </label>
                                    <label class="inline-flex items-center">
                                        <input type="radio" name="format" value="json" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                        <span class="ml-2 text-sm text-gray-700">JSON</span>
                                    </label>
                                </div>
                            </div>
                            
                            <!-- Options -->
                            <div class="space-y-2">
                                <label class="inline-flex items-center">
                                    <input type="checkbox" id="includeCharts" class="h-4 w-4 text-blue-600 focus:ring-blue-500 rounded" checked>
                                    <span class="ml-2 text-sm text-gray-700">Include Charts</span>
                                </label>
                                <label class="inline-flex items-center">
                                    <input type="checkbox" id="includeRawData" class="h-4 w-4 text-blue-600 focus:ring-blue-500 rounded">
                                    <span class="ml-2 text-sm text-gray-700">Include Raw Data</span>
                                </label>
                                <label class="inline-flex items-center">
                                    <input type="checkbox" id="sendEmail" class="h-4 w-4 text-blue-600 focus:ring-blue-500 rounded">
                                    <span class="ml-2 text-sm text-gray-700">Send via Email</span>
                                </label>
                            </div>
                            
                            <!-- Generate Button -->
                            <button id="generateReportBtn" class="w-full inline-flex items-center justify-center px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-200 font-medium">
                                <i class="fas fa-magic mr-2"></i> Generate Report
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Quick Stats -->
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b">
                        <h2 class="text-lg font-semibold text-gray-800">Quick Stats</h2>
                    </div>
                    <div class="p-4">
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-gray-600">Reports Today</span>
