<%- include('../partials/head', { 
    title: 'My Profile - Solar Monitoring System',
    extraStyles: `
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
        <style>
            .profile-header {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            }
            .avatar-upload {
                position: relative;
                display: inline-block;
            }
            .avatar-upload .avatar-preview {
                width: 150px;
                height: 150px;
                border-radius: 50%;
                border: 4px solid white;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
                background-size: cover;
                background-position: center;
                cursor: pointer;
                transition: all 0.3s ease;
            }
            .avatar-upload .avatar-preview:hover {
                transform: scale(1.05);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            }
            .avatar-upload input[type="file"] {
                display: none;
            }
            .profile-stats-card {
                transition: all 0.3s ease;
                border-left: 4px solid transparent;
            }
            .profile-stats-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            }
            .activity-timeline {
                position: relative;
                padding-left: 30px;
            }
            .activity-timeline::before {
                content: '';
                position: absolute;
                left: 10px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #e5e7eb;
            }
            .activity-item {
                position: relative;
                margin-bottom: 24px;
            }
            .activity-item::before {
                content: '';
                position: absolute;
                left: -20px;
                top: 5px;
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: #3b82f6;
                border: 2px solid white;
                box-shadow: 0 0 0 3px #bfdbfe;
            }
            .preference-toggle {
                transition: all 0.2s ease;
            }
            .preference-toggle:hover {
                background-color: #f9fafb;
            }
            .tab-button {
                transition: all 0.2s ease;
                position: relative;
            }
            .tab-button.active::after {
                content: '';
                position: absolute;
                bottom: -1px;
                left: 0;
                right: 0;
                height: 2px;
                background: #3b82f6;
            }
            .password-strength-meter {
                height: 4px;
                background: #e5e7eb;
                border-radius: 2px;
                margin-top: 4px;
                overflow: hidden;
            }
            .password-strength-meter .strength-bar {
                height: 100%;
                width: 0%;
                transition: width 0.3s ease;
            }
            .strength-weak { background-color: #ef4444; }
            .strength-fair { background-color: #f59e0b; }
            .strength-good { background-color: #10b981; }
            .strength-strong { background-color: #3b82f6; }
            .strength-very-strong { background-color: #8b5cf6; }
        </style>
    ` 
}); %>
<%- include('../partials/header'); %>
<%- include('../partials/sidebar'); %>

<!-- Main Content -->
<main class="md:ml-64 pt-16 min-h-screen bg-gray-50">
    <!-- Profile Header -->
    <div class="profile-header">
        <div class="container mx-auto px-4 py-8">
            <div class="flex flex-col md:flex-row items-center md:items-start">
                <!-- Avatar -->
                <div class="avatar-upload mb-6 md:mb-0 md:mr-8">
                    <div class="avatar-preview" id="avatarPreview" 
                         style="background-image: url('<%= user.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=667eea&color=fff&size=150` %>')">
                    </div>
                    <input type="file" id="avatarInput" accept="image/*">
                    <div class="text-center mt-3">
                        <button id="changeAvatarBtn" class="text-sm text-white bg-black bg-opacity-20 hover:bg-opacity-30 px-3 py-1 rounded-full">
                            <i class="fas fa-camera mr-1"></i> Change Photo
                        </button>
                    </div>
                </div>
                
                <!-- Profile Info -->
                <div class="flex-1 text-center md:text-left">
                    <h1 class="text-3xl font-bold text-white mb-2"><%= user.name %></h1>
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mb-4">
                        <div class="inline-flex items-center px-3 py-1 bg-white bg-opacity-20 rounded-full text-white">
                            <i class="fas fa-user-tag mr-2"></i>
                            <span class="capitalize"><%= user.role %></span>
                        </div>
                        <div class="inline-flex items-center px-3 py-1 bg-white bg-opacity-20 rounded-full text-white">
                            <i class="fas fa-envelope mr-2"></i>
                            <span><%= user.email %></span>
                        </div>
                        <% if (user.phone) { %>
                        <div class="inline-flex items-center px-3 py-1 bg-white bg-opacity-20 rounded-full text-white">
                            <i class="fas fa-phone mr-2"></i>
                            <span><%= user.phone %></span>
                        </div>
                        <% } %>
                        <% if (user.department) { %>
                        <div class="inline-flex items-center px-3 py-1 bg-white bg-opacity-20 rounded-full text-white">
                            <i class="fas fa-building mr-2"></i>
                            <span><%= user.department %></span>
                        </div>
                        <% } %>
                    </div>
                    
                    <div class="flex flex-wrap gap-3 mt-4">
                        <span class="text-white text-sm">
                            <i class="fas fa-calendar-alt mr-1"></i>
                            Member since <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %>
                        </span>
                        <span class="text-white text-sm">
                            <i class="fas fa-sign-in-alt mr-1"></i>
                            Last login: <%= user.lastLogin ? new Date(user.lastLogin).toLocaleDateString() : 'Never' %>
                        </span>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="mt-6 md:mt-0 md:ml-auto flex gap-3">
                    <button id="editProfileBtn" class="inline-flex items-center px-4 py-2 bg-white text-purple-700 rounded-lg hover:bg-gray-100 font-medium">
                        <i class="fas fa-edit mr-2"></i> Edit Profile
                    </button>
                    <button id="downloadDataBtn" class="inline-flex items-center px-4 py-2 bg-black bg-opacity-20 text-white rounded-lg hover:bg-opacity-30 font-medium">
                        <i class="fas fa-download mr-2"></i> Export Data
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="container mx-auto px-4 py-6">
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="profile-stats-card bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
                <div class="flex items-center">
                    <div class="p-3 bg-blue-100 rounded-lg mr-4">
                        <i class="fas fa-chart-line text-blue-600 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Reports Generated</p>
                        <p class="text-2xl font-bold text-gray-800" id="reportsCount">0</p>
                    </div>
                </div>
            </div>
            
            <div class="profile-stats-card bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
                <div class="flex items-center">
                    <div class="p-3 bg-green-100 rounded-lg mr-4">
                        <i class="fas fa-exclamation-triangle text-green-600 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Alerts Handled</p>
                        <p class="text-2xl font-bold text-gray-800" id="alertsCount">0</p>
                    </div>
                </div>
            </div>
            
            <div class="profile-stats-card bg-white rounded-lg shadow p-6 border-l-4 border-yellow-500">
                <div class="flex items-center">
                    <div class="p-3 bg-yellow-100 rounded-lg mr-4">
                        <i class="fas fa-clock text-yellow-600 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Avg. Session</p>
                        <p class="text-2xl font-bold text-gray-800" id="avgSession">0 min</p>
                    </div>
                </div>
            </div>
            
            <div class="profile-stats-card bg-white rounded-lg shadow p-6 border-l-4 border-purple-500">
                <div class="flex items-center">
                    <div class="p-3 bg-purple-100 rounded-lg mr-4">
                        <i class="fas fa-star text-purple-600 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Activity Score</p>
                        <p class="text-2xl font-bold text-gray-800" id="activityScore">85%</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content Tabs -->
        <div class="bg-white rounded-lg shadow mb-6">
            <!-- Tab Navigation -->
            <div class="border-b">
                <nav class="flex -mb-px">
                    <button class="tab-button py-4 px-6 font-medium text-gray-500 hover:text-gray-700 active" data-tab="profile">
                        <i class="fas fa-user mr-2"></i>Profile Details
                    </button>
                    <button class="tab-button py-4 px-6 font-medium text-gray-500 hover:text-gray-700" data-tab="security">
                        <i class="fas fa-shield-alt mr-2"></i>Security
                    </button>
                    <button class="tab-button py-4 px-6 font-medium text-gray-500 hover:text-gray-700" data-tab="preferences">
                        <i class="fas fa-cog mr-2"></i>Preferences
                    </button>
                    <button class="tab-button py-4 px-6 font-medium text-gray-500 hover:text-gray-700" data-tab="activity">
                        <i class="fas fa-history mr-2"></i>Activity
                    </button>
                    <button class="tab-button py-4 px-6 font-medium text-gray-500 hover:text-gray-700" data-tab="devices">
                        <i class="fas fa-tablet-alt mr-2"></i>Devices
                    </button>
                </nav>
            </div>
            
            <!-- Tab Content -->
            <div class="p-6">
                <!-- Profile Details Tab -->
                <div id="tab-profile" class="tab-content">
                    <form id="profileForm">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Personal Information -->
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">Personal Information</h3>
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                        <input type="text" name="name" value="<%= user.name %>" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                                        <input type="email" name="email" value="<%= user.email %>" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" readonly>
                                        <p class="text-xs text-gray-500 mt-1">Contact administrator to change email</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                                        <input type="tel" name="phone" value="<%= user.phone || '' %>" 
                                               placeholder="+265 XXX XXX XXX"
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
                                        <input type="text" name="department" value="<%= user.department || '' %>" 
                                               placeholder="e.g., Technical Department"
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Account Information -->
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">Account Information</h3>
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">User Role</label>
                                        <input type="text" value="<%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg bg-gray-50" readonly>
                                        <p class="text-xs text-gray-500 mt-1">Role can only be changed by administrator</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Account Status</label>
                                        <div class="flex items-center">
                                            <span class="px-3 py-1 rounded-full text-sm font-medium <%= user.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                                <%= user.isActive ? 'Active' : 'Inactive' %>
                                            </span>
                                            <% if (!user.isActive) { %>
                                            <button type="button" id="requestActivationBtn" class="ml-3 text-sm text-blue-600 hover:text-blue-800">
                                                Request Activation
                                            </button>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Account Created</label>
                                        <p class="text-gray-600"><%= new Date(user.createdAt).toLocaleString() %></p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Last Updated</label>
                                        <p class="text-gray-600"><%= new Date(user.updatedAt).toLocaleString() %></p>
                                    </div>
                                    <div class="pt-4">
                                        <div class="flex items-center justify-between p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                                            <div>
                                                <h4 class="font-medium text-yellow-800">Danger Zone</h4>
                                                <p class="text-sm text-yellow-600">Permanently delete your account</p>
                                            </div>
                                            <button type="button" id="deleteAccountBtn" class="px-4 py-2 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700">
                                                Delete Account
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-8 flex justify-end">
                            <button type="button" id="cancelProfileChanges" class="px-6 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 mr-3">
                                Cancel
                            </button>
                            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
                
                <!-- Security Tab -->
                <div id="tab-security" class="tab-content hidden">
                    <div class="space-y-8">
                        <!-- Change Password -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Change Password</h3>
                            <form id="changePasswordForm" class="max-w-md">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
                                        <input type="password" name="currentPassword" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
                                        <input type="password" name="newPassword" id="newPassword"
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                        <div class="password-strength-meter mt-2">
                                            <div id="passwordStrengthBar" class="strength-bar"></div>
                                        </div>
                                        <p id="passwordStrengthText" class="text-xs mt-1"></p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
                                        <input type="password" name="confirmPassword" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    </div>
                                    <div class="pt-2">
                                        <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">
                                            Update Password
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        
                        <!-- Two-Factor Authentication -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Two-Factor Authentication</h3>
                            <div class="max-w-md p-4 border border-gray-200 rounded-lg">
                                <div class="flex items-center justify-between mb-3">
                                    <div>
                                        <h4 class="font-medium text-gray-800">2FA Status</h4>
                                        <p class="text-sm text-gray-600">Add an extra layer of security</p>
                                    </div>
                                    <div class="relative">
                                        <input type="checkbox" id="enable2FA" class="sr-only" <%= user.twoFactorEnabled ? 'checked' : '' %>>
                                        <label for="enable2FA" class="toggle-switch block w-12 h-6 rounded-full cursor-pointer <%= user.twoFactorEnabled ? 'bg-blue-600' : 'bg-gray-300' %>">
                                            <span class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-200 <%= user.twoFactorEnabled ? 'transform translate-x-6' : '' %>"></span>
                                        </label>
                                    </div>
                                </div>
                                <% if (!user.twoFactorEnabled) { %>
                                <button type="button" id="setup2FABtn" class="w-full mt-2 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200">
                                    <i class="fas fa-qrcode mr-2"></i>Setup 2FA
                                </button>
                                <% } else { %>
                                <div class="mt-3 p-3 bg-green-50 border border-green-200 rounded-lg">
                                    <div class="flex items-center">
                                        <i class="fas fa-check-circle text-green-600 mr-2"></i>
                                        <span class="text-sm text-green-800">Two-factor authentication is enabled</span>
                                    </div>
                                    <button type="button" id="disable2FABtn" class="mt-2 text-sm text-red-600 hover:text-red-800">
                                        Disable 2FA
                                    </button>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Session Management -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Active Sessions</h3>
                            <div class="max-w-md space-y-3" id="activeSessions">
                                <!-- Sessions will be loaded here -->
                                <div class="text-center py-4 text-gray-400">
                                    <i class="fas fa-spinner fa-spin text-xl mb-2"></i>
                                    <p class="text-sm">Loading active sessions...</p>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="button" id="logoutAllBtn" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg text-sm font-medium hover:bg-red-200">
                                    <i class="fas fa-sign-out-alt mr-2"></i>Logout All Devices
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Preferences Tab -->
                <div id="tab-preferences" class="tab-content hidden">
                    <div class="space-y-8">
                        <!-- Notification Preferences -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Notification Preferences</h3>
                            <div class="max-w-2xl space-y-3">
                                <div class="preference-toggle p-4 border border-gray-200 rounded-lg flex items-center justify-between">
                                    <div>
                                        <h4 class="font-medium text-gray-800">Email Alerts</h4>
                                        <p class="text-sm text-gray-600">Receive alerts via email</p>
                                    </div>
                                    <div class="relative">
                                        <input type="checkbox" id="emailAlerts" class="sr-only" <%= user.notificationPreferences?.emailAlerts ? 'checked' : '' %>>
                                        <label for="emailAlerts" class="toggle-switch block w-12 h-6 rounded-full cursor-pointer <%= user.notificationPreferences?.emailAlerts ? 'bg-blue-600' : 'bg-gray-300' %>">
                                            <span class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-200 <%= user.notificationPreferences?.emailAlerts ? 'transform translate-x-6' : '' %>"></span>
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="preference-toggle p-4 border border-gray-200 rounded-lg flex items-center justify-between">
                                    <div>
                                        <h4 class="font-medium text-gray-800">Critical Alerts</h4>
                                        <p class="text-sm text-gray-600">Immediate notifications for critical issues</p>
                                    </div>
                                    <div class="relative">
                                        <input type="checkbox" id="criticalAlerts" class="sr-only" <%= user.notificationPreferences?.criticalAlerts ? 'checked' : '' %>>
                                        <label for="criticalAlerts" class="toggle-switch block w-12 h-6 rounded-full cursor-pointer <%= user.notificationPreferences?.criticalAlerts ? 'bg-blue-600' : 'bg-gray-300' %>">
                                            <span class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-200 <%= user.notificationPreferences?.criticalAlerts ? 'transform translate-x-6' : '' %>"></span>
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="preference-toggle p-4 border border-gray-200 rounded-lg flex items-center justify-between">
                                    <div>
                                        <h4 class="font-medium text-gray-800">Daily Summary</h4>
                                        <p class="text-sm text-gray-600">Receive daily system summary</p>
                                    </div>
                                    <div class="relative">
                                        <input type="checkbox" id="dailySummary" class="sr-only" <%= user.notificationPreferences?.dailySummary ? 'checked' : '' %>>
                                        <label for="dailySummary" class="toggle-switch block w-12 h-6 rounded-full cursor-pointer <%= user.notificationPreferences?.dailySummary ? 'bg-blue-600' : 'bg-gray-300' %>">
                                            <span class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-200 <%= user.notificationPreferences?.dailySummary ? 'transform translate-x-6' : '' %>"></span>
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="preference-toggle p-4 border border-gray-200 rounded-lg flex items-center justify-between">
                                    <div>
                                        <h4 class="font-medium text-gray-800">Weekly Reports</h4>
                                        <p class="text-sm text-gray-600">Receive weekly performance reports</p>
                                    </div>
                                    <div class="relative">
                                        <input type="checkbox" id="weeklyReport" class="sr-only" <%= user.notificationPreferences?.weeklyReport ? 'checked' : '' %>>
                                        <label for="weeklyReport" class="toggle-switch block w-12 h-6 rounded-full cursor-pointer <%= user.notificationPreferences?.weeklyReport ? 'bg-blue-600' : 'bg-gray-300' %>">
                                            <span class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-200 <%= user.notificationPreferences?.weeklyReport ? 'transform translate-x-6' : '' %>"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Display Preferences -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Display Preferences</h3>
                            <div class="max-w-md grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Theme</label>
                                    <select id="themeSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                        <option value="auto" <%= user.preferences?.theme === 'auto' ? 'selected' : '' %>>Auto (System)</option>
                                        <option value="light" <%= user.preferences?.theme === 'light' ? 'selected' : '' %>>Light</option>
                                        <option value="dark" <%= user.preferences?.theme === 'dark' ? 'selected' : '' %>>Dark</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Language</label>
                                    <select id="languageSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                        <option value="en" <%= user.preferences?.language === 'en' ? 'selected' : '' %>>English</option>
