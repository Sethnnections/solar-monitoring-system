// Update last update time display
function updateLastUpdateTime() {
    const element = document.getElementById('lastUpdateTime');
    if (element && dashboardState.lastUpdate) {
        const time = dashboardState.lastUpdate.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        element.innerHTML = `
            <span class="w-2 h-2 bg-yellow-500 rounded-full"></span>
            Updated ${time}
        `;
    }
}

// Show loading state
function showLoadingState(isLoading) {
    const refreshBtn = document.getElementById('refreshDashboard');
    if (refreshBtn) {
        if (isLoading) {
            refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
            refreshBtn.disabled = true;
        } else {
            refreshBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh';
            refreshBtn.disabled = false;
        }
    }
}

// Show empty chart state
function showEmptyChartState() {
    // This would show empty states in charts
    console.log('No data available for charts');
}

// Show error state
function showErrorState() {
    // This would show error states in the UI
    console.log('Error loading dashboard data');
}

// Start real-time updates
function startRealTimeUpdates() {
    // Update every 30 seconds
    setInterval(() => {
        if (!dashboardState.isLoading) {
            loadRealTimeData();
        }
    }, 30000);
}

// Load real-time data only
async function loadRealTimeData() {
    try {
        const data = await fetchData('/dashboard/api/realtime');
        if (data.success) {
            updateRealTimeMetrics(data.data);
            dashboardState.lastUpdate = new Date();
            updateLastUpdateTime();
        }
    } catch (error) {
        console.error('Error loading real-time data:', error);
    }
}

// Simulate data for demonstration (remove in production)
function simulateDataForDemo() {
    // This function simulates data for demonstration purposes
    // Remove this in production when real API is connected
    
    const now = new Date();
    const simulatedData = {
        series: {
            power: [],
            voltage: [],
            current: [],
            temperature: []
        }
    };
    
    // Generate sample data for the last 7 days
    for (let i = 6; i >= 0; i--) {
        const date = new Date(now);
        date.setDate(date.getDate() - i);
        
        for (let hour = 6; hour <= 18; hour += 3) {
            const timestamp = new Date(date);
            timestamp.setHours(hour, 0, 0, 0);
            
            const hourFactor = hour >= 10 && hour <= 14 ? 1.0 : hour >= 8 && hour <= 16 ? 0.7 : 0.2;
            const randomFactor = 0.8 + Math.random() * 0.4;
            
            simulatedData.series.power.push([timestamp.getTime(), 400 * hourFactor * randomFactor]);
            simulatedData.series.voltage.push([timestamp.getTime(), 12.0 + (Math.random() - 0.5) * 0.5]);
            simulatedData.series.current.push([timestamp.getTime(), (400 * hourFactor * randomFactor) / (12.0 + (Math.random() - 0.5) * 0.5)]);
            simulatedData.series.temperature.push([timestamp.getTime(), 25 + (hour - 6) * 2 + (Math.random() - 0.5) * 3]);
        }
    }
    
    return simulatedData;
}

