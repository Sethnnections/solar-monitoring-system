<%- include('../partials/head', { title: 'Alerts - Solar Monitoring System' }); %>
<%- include('../partials/header'); %>
<%- include('../partials/sidebar'); %>

<!-- Main Content -->
<main class="md:ml-64 pt-16 min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-6">
        <!-- Page Header -->
        <div class="mb-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">Alert Management</h1>
                    <p class="text-gray-600">Monitor and manage system alerts and notifications</p>
                </div>
                <div class="mt-4 md:mt-0 flex space-x-3">
                    <!-- Create Alert Button -->
                    <button id="createAlertBtn" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-200">
                        <i class="fas fa-plus-circle mr-2"></i> Create Alert
                    </button>
                    
                    <!-- Bulk Actions Dropdown -->
                    <div class="relative" id="bulkActionsDropdown">
                        <button id="bulkActionsBtn" class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition duration-200">
                            <i class="fas fa-tasks mr-2"></i> Bulk Actions
                            <i class="fas fa-chevron-down ml-2"></i>
                        </button>
                        <div id="bulkActionsMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg z-10">
                            <div class="py-1">
                                <button class="bulk-action-btn w-full text-left px-4 py-2 hover:bg-gray-100 text-gray-700" data-action="acknowledge">
                                    <i class="fas fa-check-circle mr-2 text-green-600"></i>Acknowledge Selected
                                </button>
                                <button class="bulk-action-btn w-full text-left px-4 py-2 hover:bg-gray-100 text-gray-700" data-action="resolve">
                                    <i class="fas fa-check-double mr-2 text-blue-600"></i>Resolve Selected
                                </button>
                                <div class="border-t my-1"></div>
                                <button class="bulk-action-btn w-full text-left px-4 py-2 hover:bg-gray-100 text-red-600" data-action="delete">
                                    <i class="fas fa-trash mr-2"></i>Delete Selected
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="relative" id="exportDropdown">
                        <button id="exportBtn" class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition duration-200">
                            <i class="fas fa-download mr-2"></i> Export
                            <i class="fas fa-chevron-down ml-2"></i>
                        </button>
                        <div id="exportMenu" class="hidden absolute right-0 mt-2 w-32 bg-white rounded-lg shadow-lg z-10">
                            <div class="py-1">
                                <button class="export-option w-full text-left px-4 py-2 hover:bg-gray-100 text-gray-700" data-format="csv">
                                    <i class="fas fa-file-csv mr-2 text-green-600"></i>CSV
                                </button>
                                <button class="export-option w-full text-left px-4 py-2 hover:bg-gray-100 text-gray-700" data-format="json">
                                    <i class="fas fa-file-code mr-2 text-blue-600"></i>JSON
                                </button>
                            </div>
                        </div>
                    </div>
                                        
                    
                    <!-- Refresh Button -->
                    <button id="refreshAlerts" class="inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition duration-200">
                        <i class="fas fa-sync-alt mr-2"></i> Refresh
                    </button>
                </div>
            </div>
            
            <!-- Alert Summary Cards -->
            <div class="mt-6 grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-red-100 rounded-lg mr-4">
                            <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Critical Alerts</p>
                            <p class="text-2xl font-bold text-gray-800" id="criticalCount">
                                <%= stats && stats.bySeverity && stats.bySeverity.critical ? stats.bySeverity.critical : 0 %>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-orange-100 rounded-lg mr-4">
                            <i class="fas fa-exclamation-circle text-orange-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">High Priority</p>
                            <p class="text-2xl font-bold text-gray-800" id="highCount">
                                <%= stats && stats.bySeverity && stats.bySeverity.high ? stats.bySeverity.high : 0 %>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-yellow-100 rounded-lg mr-4">
                            <i class="fas fa-info-circle text-yellow-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Active Alerts</p>
                            <p class="text-2xl font-bold text-gray-800" id="activeCount">
                                <%= stats && stats.total ? stats.total : 0 %>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-center">
                        <div class="p-3 bg-green-100 rounded-lg mr-4">
                            <i class="fas fa-check-circle text-green-600 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Resolved Today</p>
                            <p class="text-2xl font-bold text-gray-800" id="resolvedCount">
                                <%= stats && stats.resolved ? stats.resolved : 0 %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Filters and Search -->
        <div class="bg-white rounded-lg shadow mb-6">
            <div class="p-4">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <!-- Status Filter -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                        <select id="statusFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active Alerts</option>
                            <option value="unacknowledged" <%= filters.status === 'unacknowledged' ? 'selected' : '' %>>Unacknowledged</option>
                            <option value="acknowledged" <%= filters.status === 'acknowledged' ? 'selected' : '' %>>Acknowledged</option>
                            <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                            <option value="">All Alerts</option>
                        </select>
                    </div>
                    
                    <!-- Severity Filter -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Severity</label>
                        <select id="severityFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">All Severities</option>
                            <% Object.keys(severityLevels).forEach(function(severity) { %>
                                <option value="<%= severityLevels[severity] %>" 
                                        <%= filters.severity === severityLevels[severity] ? 'selected' : '' %>>
                                    <%= severityLevels[severity] %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    
                    <!-- Type Filter -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Alert Type</label>
                        <select id="typeFilter" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">All Types</option>
                            <% Object.keys(alertTypes).forEach(function(type) { %>
                                <option value="<%= alertTypes[type] %>" 
                                        <%= filters.type === alertTypes[type] ? 'selected' : '' %>>
                                    <%= alertTypes[type] %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    
                    <!-- Search -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Search</label>
                        <div class="relative">
                            <input type="text" id="searchInput" 
                                   placeholder="Search alerts..." 
                                   class="w-full px-3 py-2 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                        </div>
                    </div>
                </div>
                
                <!-- Advanced Filters (Collapsible) -->
                <div class="mt-4">
                    <button id="toggleAdvancedFilters" class="text-sm text-blue-600 hover:text-blue-800 flex items-center">
                        <i class="fas fa-filter mr-2"></i>
                        <span>Advanced Filters</span>
                        <i class="fas fa-chevron-down ml-2"></i>
                    </button>
                    
                    <div id="advancedFilters" class="hidden mt-4 p-4 bg-gray-50 rounded-lg">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
                                <input type="date" id="dateFrom" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">to</label>
                                <input type="date" id="dateTo" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Device ID</label>
                                <input type="text" id="deviceFilter" placeholder="Device ID" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                            </div>
                        </div>
                        <div class="mt-4">
                            <button id="applyAdvancedFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                                Apply Filters
                            </button>
                            <button id="resetFilters" class="ml-2 px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300">
                                Reset All
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Alerts Table -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b">
                        <div class="flex justify-between items-center">
                            <h2 class="text-lg font-semibold text-gray-800">Alerts List</h2>
                            <div class="text-sm text-gray-600">
                                <span id="selectedCount">0</span> selected of <span id="totalAlerts"><%= pagination ? pagination.total : 0 %></span> alerts
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead>
                                    <tr>
                                        <th class="px-4 py-3 text-left">
                                            <input type="checkbox" id="selectAll" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                        </th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Alert</th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Severity</th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200" id="alertsTableBody">
                                    <% if (alerts && alerts.length > 0) { %>
                                        <% alerts.forEach(function(alert) { %>
                                            <tr class="hover:bg-gray-50" data-alert-id="<%= alert._id %>">
                                                <td class="px-4 py-3">
                                                    <input type="checkbox" class="alert-checkbox rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div>
                                                        <div class="font-medium text-gray-900"><%= alert.title %></div>
                                                        <div class="text-sm text-gray-500"><%= alert.message %></div>
                                                        <div class="text-xs text-gray-400 mt-1">
                                                            <i class="fas fa-microchip mr-1"></i><%= alert.deviceId || 'ESP32_SOLAR_01' %>
                                                            <span class="mx-2">•</span>
                                                            <i class="fas fa-map-marker-alt mr-1"></i><%= alert.location || 'Kadidi Health Center' %>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                                        <%= alert.severity === 'critical' ? 'bg-red-100 text-red-800' : 
                                                           alert.severity === 'high' ? 'bg-orange-100 text-orange-800' : 
                                                           alert.severity === 'medium' ? 'bg-yellow-100 text-yellow-800' : 
                                                           'bg-blue-100 text-blue-800' %>">
                                                        <i class="fas 
                                                            <%= alert.severity === 'critical' ? 'fa-exclamation-triangle' : 
                                                               alert.severity === 'high' ? 'fa-exclamation-circle' : 
                                                               alert.severity === 'medium' ? 'fa-info-circle' : 
                                                               'fa-info' %> mr-1">
                                                        </i>
                                                        <%= alert.severity %>
                                                    </span>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="flex items-center">
                                                        <% if (alert.resolved) { %>
                                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                <i class="fas fa-check-circle mr-1"></i>Resolved
                                                            </span>
                                                        <% } else if (alert.acknowledged) { %>
                                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                                <i class="fas fa-user-check mr-1"></i>Acknowledged
                                                            </span>
                                                        <% } else { %>
                                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                <i class="fas fa-clock mr-1"></i>Active
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 text-sm text-gray-500">
                                                    <div class="whitespace-nowrap">
                                                        <%= new Date(alert.createdAt).toLocaleDateString() %>
                                                    </div>
                                                    <div class="text-xs text-gray-400">
                                                        <%= alert.timeAgo %>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="flex space-x-2">
                                                        <% if (!alert.resolved) { %>
                                                            <% if (!alert.acknowledged) { %>
                                                                <button class="acknowledge-btn inline-flex items-center px-2 py-1 text-xs bg-blue-50 text-blue-700 rounded hover:bg-blue-100" 
                                                                        data-id="<%= alert._id %>">
                                                                    <i class="fas fa-check-circle mr-1"></i>Acknowledge
                                                                </button>
                                                            <% } %>
                                                            <button class="resolve-btn inline-flex items-center px-2 py-1 text-xs bg-green-50 text-green-700 rounded hover:bg-green-100" 
                                                                    data-id="<%= alert._id %>">
                                                                <i class="fas fa-check-double mr-1"></i>Resolve
                                                            </button>
                                                        <% } %>
                                                        <button class="view-btn inline-flex items-center px-2 py-1 text-xs bg-gray-50 text-gray-700 rounded hover:bg-gray-100" 
                                                                data-id="<%= alert._id %>">
                                                            <i class="fas fa-eye mr-1"></i>View
                                                        </button>
                                                        <% if (user.role === 'admin') { %>
                                                            <button class="delete-btn inline-flex items-center px-2 py-1 text-xs bg-red-50 text-red-700 rounded hover:bg-red-100" 
                                                                    data-id="<%= alert._id %>">
                                                                <i class="fas fa-trash mr-1"></i>Delete
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="px-4 py-12 text-center text-gray-500">
                                                <i class="fas fa-bell-slash text-4xl mb-3 text-gray-300"></i>
                                                <p class="text-lg">No alerts found</p>
                                                <p class="text-sm mt-1">Try adjusting your filters or create a new alert</p>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Pagination -->
                        <% if (pagination) { %>
                            <div class="mt-6 flex items-center justify-between">
                                <div class="text-sm text-gray-700">
                                    Showing <span class="font-medium"><%= pagination.startItem %></span> to 
                                    <span class="font-medium"><%= pagination.endItem %></span> of 
                                    <span class="font-medium"><%= pagination.total %></span> alerts
                                </div>
                                <div class="flex space-x-2">
                                    <% if (pagination.prevPage) { %>
                                        <a href="?<%= new URLSearchParams({...filters, page: pagination.prevPage }).toString() %>" 
                                           class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                                            Previous
                                        </a>
                                    <% } %>
                                    
                                    <% if (pagination && pagination.pages && Array.isArray(pagination.pages)) { %>
                                        <% pagination.pages.forEach(function(page) { %>
                                            <a href="?<%= new URLSearchParams({...filters, page: page }).toString() %>" 
                                               class="px-3 py-2 <%= page === pagination.currentPage ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50' %> rounded-lg text-sm font-medium">
                                                <%= page %>
                                            </a>
                                        <% }); %>
                                    <% } %>
                                    
                                    <% if (pagination.nextPage) { %>
                                        <a href="?<%= new URLSearchParams({...filters, page: pagination.nextPage }).toString() %>" 
                                           class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                                            Next
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Right Column - Stats & Actions -->
            <div class="space-y-6">
                <!-- Alert Statistics -->
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b">
                        <h2 class="text-lg font-semibold text-gray-800">Alert Statistics</h2>
                    </div>
                    <div class="p-4">
                        <div class="space-y-4">
                            <% if (stats && stats.bySeverity) { %>
                                <div>
                                    <div class="flex justify-between text-sm mb-1">
                                        <span class="text-gray-600">Critical</span>
                                        <span class="font-medium"><%= stats.bySeverity.critical || 0 %></span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                    <div class="progress-bar-critical bg-red-600 h-2 rounded-full" 
                                        style="width: <%= (stats.bySeverity.critical || 0) / Math.max(stats.total, 1) * 100 %>%"></div>
                                </div>
                                </div>
                                
                                <div>
                                    <div class="flex justify-between text-sm mb-1">
                                        <span class="text-gray-600">High</span>
                                        <span class="font-medium"><%= stats.bySeverity.high || 0 %></span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="progress-bar-high bg-orange-500 h-2 rounded-full" 
                                            style="width: <%= (stats.bySeverity.high || 0) / Math.max(stats.total, 1) * 100 %>%"></div>
                                    </div>
                                </div>
                                
                                <div>
                                    <div class="flex justify-between text-sm mb-1">
                                        <span class="text-gray-600">Medium</span>
                                        <span class="font-medium"><%= stats.bySeverity.medium || 0 %></span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="progress-bar-medium bg-yellow-500 h-2 rounded-full" 
                                            style="width: <%= (stats.bySeverity.medium || 0) / Math.max(stats.total, 1) * 100 %>%"></div>
                                    </div>
                                </div>
                                
                                <div>
                                    <div class="flex justify-between text-sm mb-1">
                                        <span class="text-gray-600">Low</span>
                                        <span class="font-medium"><%= stats.bySeverity.low || 0 %></span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="progress-bar-low bg-blue-500 h-2 rounded-full" 
                                            style="width: <%= (stats.bySeverity.low || 0) / Math.max(stats.total, 1) * 100 %>%"></div>
                                    </div>
                                </div>
                            <% } %>
                            
                            <div class="pt-4 border-t">
                                <div class="grid grid-cols-2 gap-4">
                                    <div class="text-center">
                                        <div class="text-2xl font-bold text-gray-800"><%= stats && stats.acknowledged ? stats.acknowledged : 0 %></div>
                                        <div class="text-sm text-gray-600">Acknowledged</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-2xl font-bold text-gray-800"><%= stats && stats.resolved ? stats.resolved : 0 %></div>
                                        <div class="text-sm text-gray-600">Resolved</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Quick Actions -->
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b">
                        <h2 class="text-lg font-semibold text-gray-800">Quick Actions</h2>
                    </div>
                    <div class="p-4">
                        <div class="space-y-3">
                            <button id="acknowledgeAllActive" class="w-full flex items-center justify-between p-3 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition duration-200">
                                <div class="flex items-center">
                                    <i class="fas fa-check-circle mr-3"></i>
                                    <span>Acknowledge All Active</span>
                                </div>
                                <i class="fas fa-chevron-right"></i>
                            </button>
                            
                            <button id="resolveAllAcknowledged" class="w-full flex items-center justify-between p-3 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition duration-200">
                                <div class="flex items-center">
                                    <i class="fas fa-check-double mr-3"></i>
                                    <span>Resolve All Acknowledged</span>
                                </div>
                                <i class="fas fa-chevron-right"></i>
                            </button>
                            
                            <button id="sendTestAlert" class="w-full flex items-center justify-between p-3 bg-purple-50 text-purple-700 rounded-lg hover:bg-purple-100 transition duration-200">
                                <div class="flex items-center">
                                    <i class="fas fa-envelope mr-3"></i>
                                    <span>Send Test Alert</span>
                                </div>
                                <i class="fas fa-chevron-right"></i>
                            </button>
                            
                            <button id="viewTrends" class="w-full flex items-center justify-between p-3 bg-gray-50 text-gray-700 rounded-lg hover:bg-gray-100 transition duration-200">
                                <div class="flex items-center">
                                    <i class="fas fa-chart-line mr-3"></i>
                                    <span>View Alert Trends</span>
                                </div>
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Alert Types Distribution -->
                <div class="bg-white rounded-lg shadow">
