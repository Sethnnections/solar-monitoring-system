<!-- Correct Sidebar based on your actual routes -->
<aside class="bg-gradient-to-b from-gray-900 to-black text-white w-64 min-h-screen fixed left-0 top-0 pt-16 z-30 glass-sidebar" id="sidebar">
    <div class="p-4 h-full overflow-y-auto">
        <!-- User Info Section -->
    
        
        <nav class="mt-2">
            <!-- Dashboard Routes -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-tachometer-alt w-4 mr-2"></i>
                    Dashboard
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/dashboard" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath === '/dashboard' ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-chart-line w-5 mr-3"></i>
                            Overview
                        </a>
                    </li>
                    <li>
                        <a href="/dashboard/live-data" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/dashboard/live-data') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-bolt w-5 mr-3"></i>
                            Live Data
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Alerts Routes -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-bell w-4 mr-2"></i>
                    Alerts
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/alerts" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/alerts') && !currentPath.includes('/api/') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-exclamation-triangle w-5 mr-3"></i>
                            Alerts Management
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Reports Routes -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-file-alt w-4 mr-2"></i>
                    Reports
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/reports" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/reports') && !currentPath.includes('/api/') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-chart-bar w-5 mr-3"></i>
                            Report Center
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- User Management Routes -->
            <% if (user.role === 'admin') { %>
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-users w-4 mr-2"></i>
                    User Management
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/users" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/users') && !currentPath.includes('/api/') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-users-cog w-5 mr-3"></i>
                            Manage Users
                        </a>
                    </li>
                </ul>
            </div>
            <% } %>
            
            <!-- Auth Routes -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-user w-4 mr-2"></i>
                    Account
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/profile" class="flex items-center px-3 py-2.5 rounded-lg <%= currentPath && currentPath.includes('/profile') ? 'bg-yellow-500 text-black font-medium shadow-lg' : 'hover:bg-gray-800 hover:text-white hover:shadow-md' %> transition-all duration-200">
                            <i class="fas fa-user-circle w-5 mr-3"></i>
                            My Profile
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- API Status -->
            <div class="mb-6">
                <h3 class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 flex items-center">
                    <i class="fas fa-plug w-4 mr-2"></i>
                    System
                </h3>
                <ul class="space-y-1">
                    <li>
                        <a href="/api/status" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200" target="_blank">
                            <i class="fas fa-server w-5 mr-3"></i>
                            API Status
                        </a>
                    </li>
                    <li>
                        <a href="/api/health" class="flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white hover:shadow-md transition-all duration-200" target="_blank">
                            <i class="fas fa-heartbeat w-5 mr-3"></i>
                            Health Check
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
        
        <!-- Quick Stats -->
        <div class="mt-8 pt-6 border-t border-gray-700">
            <div class="grid grid-cols-2 gap-2 mb-4">
                <div class="bg-gray-800 p-2 rounded-lg text-center">
                    <p class="text-xs text-gray-400">Active Alerts</p>
                    <p class="text-lg font-semibold text-yellow-500" id="sidebarAlertsCount">
                        <% if (alertStats && alertStats.total) { %>
                            <%= alertStats.total %>
                        <% } else { %>
                            0
                        <% } %>
                    </p>
                </div>
                <div class="bg-gray-800 p-2 rounded-lg text-center">
                    <p class="text-xs text-gray-400">Uptime</p>
                    <p class="text-lg font-semibold text-green-500">
                        <% if (systemStatus && systemStatus.status === 'healthy') { %>
                            99.9%
                        <% } else { %>
                            <span class="text-red-500">Offline</span>
                        <% } %>
                    </p>
                </div>
            </div>
        </div>
    </div>
</aside>

<!-- Mobile menu overlay -->
<div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-70 backdrop-blur-sm z-20 hidden"></div>

<style>
    .glass-sidebar {
        background: linear-gradient(135deg, rgba(31, 41, 55, 0.95), rgba(17, 24, 39, 0.95));
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 5px 0 25px rgba(0, 0, 0, 0.3);
    }
</style>