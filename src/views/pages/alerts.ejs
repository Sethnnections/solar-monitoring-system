<%- include('../partials/head', { title: 'Alerts Management' }); %>
<%- include('../partials/header'); %>
<%- include('../partials/sidebar', { currentPath: '/alerts' }); %>

<main class="md:ml-64 pt-16 min-h-screen bg-gradient-to-b from-gray-50 to-gray-100">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto">
            <div class="text-center py-12">
                <div class="inline-block p-4 bg-yellow-100 rounded-full mb-6">
                    <i class="fas fa-exclamation-triangle text-yellow-600 text-4xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-800 mb-4">Alerts Management</h1>
                <p class="text-lg text-gray-600 mb-8">This page is coming soon. The alerts management interface will be available in the next update.</p>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                    <div class="bg-white rounded-lg shadow-lg p-6 border border-gray-200">
                        <div class="text-yellow-500 mb-4">
                            <i class="fas fa-bell text-2xl"></i>
                        </div>
                        <h3 class="font-semibold text-gray-800 mb-2">Active Alerts</h3>
                        <p class="text-gray-600 text-sm">View and manage all active system alerts</p>
                    </div>
                    
                    <div class="bg-white rounded-lg shadow-lg p-6 border border-gray-200">
                        <div class="text-green-500 mb-4">
                            <i class="fas fa-history text-2xl"></i>
                        </div>
                        <h3 class="font-semibold text-gray-800 mb-2">Alert History</h3>
                        <p class="text-gray-600 text-sm">Access historical alert data and trends</p>
                    </div>
                    
                    <div class="bg-white rounded-lg shadow-lg p-6 border border-gray-200">
                        <div class="text-blue-500 mb-4">
                            <i class="fas fa-cog text-2xl"></i>
                        </div>
                        <h3 class="font-semibold text-gray-800 mb-2">Alert Settings</h3>
                        <p class="text-gray-600 text-sm">Configure alert thresholds and notifications</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer'); %>
<%- include('../partials/scripts'); %>